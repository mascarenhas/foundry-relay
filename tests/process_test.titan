local test = import "test"
local os = import "os"
local fs = import "fs"
local uv = import "uv"
local async = import "async"
local http = import "http"
local net = import "net"
local websocket = import "websocket"
local timer = import "timer"
local string = import "string"
local wire = import "relay.wire"
local hub = import "relay.hub"

local function consume(stream: os.InputStream): string
  local output = string.writer()
  for chunk in stream:read do output:write(chunk) end
  return output:drain()
end

local function stop(process: os.Process)
  if process:is_running() then process:kill("kill") end
  process:wait()
  if process.stdin then process.stdin:close() end
  if process.stdout then process.stdout:close() end
  if process.stderr then process.stderr:close() end
end

local function available_port(): integer
  local first = 55000 + (os.pid() % 1000)
  for port = first, first + 99 do
    do
      local probe = net.listen("127.0.0.1", port)
      probe:close()
      return port
    catch
      if error is async.OperationError then
        local problem = error as async.OperationError
        if problem.name ~= "EADDRINUSE" then raise end
      else
        raise
      end
    end
  end
  raise "no available port for standalone executable test"
end

function test_relocated_executable_runs_without_compiler_or_provider(_context: test.Context)
  local source? = os.getenv("RELAY_TEST_EXECUTABLE")
  if not source then test.skip("capability: set RELAY_TEST_EXECUTABLE or use make test") end
  local binary = fs.tmpname()
  defer fs.unlink(binary)
  fs.write_file(binary, fs.read_file(source))
  local chmod = uv.fs_t()
  defer uv.fs_req_cleanup(chmod)
  test.assert(uv.fs_chmod(nil, chmod, binary, 448, nil) == 0, "could not make private executable runnable")
  local database = fs.tmpname()
  defer fs.unlink(database)
  local port = available_port()
  local process = os.spawn(binary, {},
    os.with_env("FOUNDRY_REST_API_KEY", "process-api-key"),
    os.with_env("FOUNDRY_PAIRING_CODE", "test42"),
    os.with_env("RELAY_DATABASE", database),
    os.with_env("RELAY_HOST", "127.0.0.1"),
    os.with_env("RELAY_PORT", "" .. port),
    os.with_env("RELAY_PUBLIC_URL", "ws://127.0.0.1:" .. port .. "/relay"),
    os.with_env("RELAY_LOG_LEVEL", "info"),
    os.with_env("RELAY_CHROME", ""), os.with_env("RELAY_MAX_SESSIONS", "4"),
    os.with_env("RELAY_SESSION_TIMEOUT_MS", "120000"),
    os.with_env("TITAN_PATH_0_6", "/nonexistent-foundry-relay-provider"),
    os.with_env("TITAN_ROCKS_ROOT", "/nonexistent-foundry-relay-sdk"),
    os.with_env("LUA_PATH", ""), os.with_env("LUA_CPATH", ""),
    os.with_env("PATH", "/nonexistent-foundry-relay-tools"))
  defer stop(process)
  process.stdin:close()
  local ready? = process.stderr:read_until("\n", true)
  test.assert(ready ~= nil, "relocated executable exited before its startup record")
  local started = wire.object(ready)
  test.assert(wire.text(started, "event") == "server_started" and
    wire.text(started, "level") == "info" and started["port"] == port,
    "relocated static executable failed to start")
  local stderr = async.run<|string, value|>(function (): string return consume(process.stderr) end)
  defer hub.drain(stderr)
  local stdout = async.run<|string, value|>(function (): string return consume(process.stdout) end)
  defer hub.drain(stdout)
  local health = http.get("http://127.0.0.1:" .. port .. "/health")
  defer health:close()
  local health_body = string.writer()
  for chunk in health:read do health_body:write(chunk) end
  test.assert(health.status == 200 and wire.text(wire.object(health_body:drain()), "status") == "ok")
  local headers = http.headers({http.Header("Content-Type", "application/json")})
  local paired = http.request("POST", "http://127.0.0.1:" .. port .. "/auth/pair", headers,
    [[{"code":"TEST42","worldId":"native-process","worldTitle":"Process"}]])
  defer paired:close()
  local body = string.writer()
  for chunk in paired:read do body:write(chunk) end
  local credentials = wire.object(body:drain())
  test.assert(paired.status == 200 and wire.text(credentials, "clientId") ~= "",
    "relocated executable did not pair a world")
  local id = wire.text(credentials, "clientId")
  local world = websocket.connect("ws://127.0.0.1:" .. port .. "/relay?id=" .. id)
  defer world:close()
  local auth: {string: value} = {["type"] = "auth", ["token"] = wire.text(credentials, "token")}
  world:write(websocket.TEXT, wire.encode(auth))
  for index = 1, 7 do
    local kind?, contents? = world:read()
    test.assert(kind == websocket.TEXT)
    local update = wire.object(contents)
    if index == 1 then test.assert(wire.text(update, "type") == "auth-success") end
  end
  local streaming = http.get("http://127.0.0.1:" .. port .. "/chat/subscribe?clientId=" .. id,
    http.headers({http.Header("x-api-key", "process-api-key")}))
  defer streaming:close()
  test.assert(streaming.status == 200)
  streaming:read_until("\n\n", true)
  local _, subscribed? = world:read()
  test.assert(wire.object(subscribed)["count"] == 1)
  streaming:close() -- The next event must retire this committed HTTP stream.
  local sending = async.run<|nil, value|>(function (): nil
    for index = 1, 128 do
      world:write(websocket.TEXT, [[{"type":"chat-event","data":{"eventType":"update","id":"scratch"}}]])
      timer.sleep(0)
    end
    return nil
  end)
  defer hub.drain(sending)
  local _, unsubscribed? = world:read()
  local removed = wire.object(unsubscribed)
  test.assert(wire.text(removed, "channel") == "chat-events" and removed["count"] == 0,
    "closed SSE client retained its subscription")
  test.assert(async.join(sending):has_succeeded(), "SSE event producer did not finish")
  -- Keep the world online so signal shutdown must record its disconnect before
  -- draining the logger, even if the accepted HTTP handler retires later.
  process:kill("term")
  local exit = process:wait()
  test.assert(exit.code == 0 and exit.signal == nil, "server failed graceful SIGTERM shutdown")
  case async.join(stderr)
  when succeeded(lines) then
    local requests = 0
    local connected = 0
    local disconnected = 0
    for line in string.split(lines, "\n") do
      if line ~= "" then
        local entry = wire.object(line)
        local event = wire.text(entry, "event")
        local level = wire.text(entry, "level")
        -- This test deliberately breaks an SSE response. Its failed write is
        -- an expected error record; info still includes error severity.
        test.assert(level == "info" or (level == "error" and event == "http_request_failed" and
          wire.text(entry, "reason") == "io_failure"),
          "standalone server emitted an unexpected event severity or failure")
        if event == "http_request" then requests = requests + 1 end
        if event == "websocket_connected" then connected = connected + 1 end
        if event == "websocket_disconnected" then disconnected = disconnected + 1 end
        test.assert(not string.find(line, "process-api-key", 1, true) and
          not string.find(line, "TEST42", 1, true) and
          not string.find(line, wire.text(credentials, "token"), 1, true),
          "standalone log exposed a credential")
      end
    end
    test.assert(requests == 4 and connected == 1 and disconnected == 1,
      "standalone server omitted or duplicated request/session logs")
  when failed(failure) then failure:raise()
  else raise "stderr reader failed"
  end
  case async.join(stdout)
  when succeeded(output) then test.assert(output == "", "server emitted non-JSON stdout diagnostics")
  when failed(failure) then failure:raise()
  else raise "stdout reader failed"
  end
end
