local test = import "test"
local input = import "relay.spike_input"
local iteration = import "iteration"

function test_fixture_accepts_empty_password(_context: test.Context)
  local parsed = input.parse("# local fixture\r\nFOUNDRY_URL=https://example.test/\r\n" ..
    "WORLD_NAME=sandbox\r\nGM_USER=Test GM\r\nGM_PASSWORD\r\nADMIN_PASSWORD=unused\r\n")
  test.assert(parsed.url == "https://example.test/")
  test.assert(parsed.origin == "https://example.test")
  test.assert(parsed.world == "sandbox" and parsed.user == "Test GM")
  test.assert(parsed.password == "")
end

function test_password_is_literal_data(_context: test.Context)
  local parsed = input.parse("FOUNDRY_URL=http://127.0.0.1:30000\nWORLD_NAME=w\n" ..
    "GM_USER=u\nGM_PASSWORD= $(never-run)=literal # text ")
  test.assert(parsed.password == " $(never-run)=literal # text ")
end

function test_origin_matches_browser_default_ports(_context: test.Context)
  test.assert(input.Input("https://example.test:443/", "w", "u", "").origin ==
    "https://example.test")
  test.assert(input.Input("http://example.test:80/", "w", "u", "").origin ==
    "http://example.test")
  test.assert(input.Input("https://[::1]:443/", "w", "u", "").origin == "https://[::1]")
  test.assert(input.Input("http://[::1]:30000/", "w", "u", "").origin == "http://[::1]:30000")
end

local function rejects(source: string)
  local caught = false
  do
    input.parse(source)
  catch
    caught = true
    test.assert(error == "Unknown spike fixture field" or
      error == "Duplicate spike fixture field" or error == "Invalid Foundry URL" or
      error == "Foundry world and user are required", "unsafe diagnostic")
  end
  test.assert(caught, "invalid fixture was accepted")
end

function test_fixture_validation(context: test.Context)
  local base = "FOUNDRY_URL=https://example.test\nWORLD_NAME=w\nGM_USER=u\n"
  context:run("duplicates", function (_child: test.Context)
    rejects(base .. "GM_USER=other")
  end)
  context:run("unknown fields", function (_child: test.Context)
    rejects(base .. "SECRET_VALUE=do-not-report")
  end)
  context:run("missing world", function (_child: test.Context)
    rejects("FOUNDRY_URL=https://example.test\nGM_USER=u")
  end)
  for _, address in iteration.ipairs({"file:///private", "https://user:password@example.test/",
                      "https://example.test/?secret=value", "https://example.test/#secret"}) do
    context:run("URL validation", function (_child: test.Context)
      rejects("FOUNDRY_URL=" .. address .. "\nWORLD_NAME=w\nGM_USER=u")
    end)
  end
end
