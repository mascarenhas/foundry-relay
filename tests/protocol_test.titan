local test = import "test"
local wire = import "relay.wire"
local config = import "relay.config"
local hub = import "relay.hub.titan"
local world = import "relay.world.titan"
local protocol = import "relay.world_protocol"
local thread = import "thread"
local uv = import "uv"
local async = import "async"
local timer = import "timer"
local string = import "string"

function test_nulls_and_nested_arrays_round_trip(_context: test.Context)
  local source = [[{"a":[1,null,null],"b":null,"c":{"d":null}}]]
  test.assert(wire.encode(wire.decode(source)) == source,
    "relay changed explicit nulls or trailing array positions")
end

function test_empty_objects_arrays_and_false_stay_distinct(_context: test.Context)
  local source = [[{"a":[],"b":{},"c":false,"d":0,"e":""}]]
  test.assert(wire.encode(wire.object(source)) == source)
end

function test_secret_comparison_observes_every_byte(_context: test.Context)
  test.assert(config.secret_equal("api-key", "api-key"))
  test.assert(not config.secret_equal("api-key", "API-key"))
  test.assert(not config.secret_equal("api-key", "api-key\0"))
  test.assert(not config.secret_equal("", "api-key"))
end

function test_error_json_escapes_protocol_bytes(_context: test.Context)
  local source = "quoted \" text\nline\0end"
  local decoded = wire.object(wire.error_body(source))
  test.assert(wire.text(decoded, "error") == source)
end

function test_wire_rejects_non_object_envelopes(_context: test.Context)
  local caught = false
  do wire.object("[]")
  catch caught = true end
  test.assert(caught, "array was accepted as a Foundry protocol envelope")
end

function test_reply_completion_wakes_exact_pending_request(_context: test.Context)
  local tx, rx = thread.channel<|protocol.WorldReply|>(1)
  defer do rx:close(); tx:close() end
  local pending = world.Pending(protocol.WorldRequest("test", "entity", "{}", uv.hrtime() + 1000000000, tx), false, nil)
  local waiting = async.run<|protocol.WorldReply, value|>(rx:receive)
  defer hub.drain(waiting)
  pending:complete(200, "first")
  pending:complete(400, "duplicate")
  case async.join(waiting)
  when succeeded(reply) then test.assert(reply.status == 200 and reply.body == "first" and reply.request_id == "test")
  when failed(failure) then failure:raise()
  else raise "request waiter did not finish"
  end
  local duplicate = rx:try_receive()
  test.assert(not duplicate, "duplicate completion sent a second reply")
end

function test_cancelled_pending_request_cannot_be_resumed(_context: test.Context)
  local tx, rx = thread.channel<|protocol.WorldReply|>(1)
  defer tx:close()
  local pending = world.Pending(protocol.WorldRequest("test", "entity", "{}", uv.hrtime() + 1000000000, tx), false, nil)
  rx:close()
  pending:complete(200, "late")
  test.assert(pending.completed, "closed reply endpoint prevented terminal bookkeeping")
end

function test_late_reply_stores_result_before_wait_registration(_context: test.Context)
  local tx, rx = thread.channel<|protocol.WorldReply|>(1)
  defer do rx:close(); tx:close() end
  local pending = world.Pending(protocol.WorldRequest("test", "entity", "{}", uv.hrtime() + 1000000000, tx), false, nil)
  pending:complete(200, "already delivered")
  test.assert(rx:receive().body == "already delivered")
end

function test_large_json_response_preserves_multibyte_text(_context: test.Context)
  local text = string.rep("世界🚀\n", 20000)
  local object: {string: value} = { ["text"] = text }
  test.assert(wire.text(wire.object(wire.encode(object)), "text") == text)
end

function test_queued_output_skips_expired_and_cancelled_requests(_context: test.Context)
  local tx, rx = thread.channel<|protocol.WorldReply|>(1)
  defer do rx:close(); tx:close() end
  local pending = world.Pending(protocol.WorldRequest("request", "entity", "{}", uv.hrtime() + 1000000000, tx), false, nil)
  local requests: {string: world.Pending} = {["request"] = pending}
  local message = world.Outgoing("request payload", "request")
  test.assert(message:should_send(requests), "live queued request was discarded")
  pending:complete(408, "expired")
  test.assert(not message:should_send(requests), "expired request remained eligible for output")
  requests["request"] = nil
  test.assert(not message:should_send(requests), "cancelled request remained eligible for output")
  test.assert(world.Outgoing("subscription update", nil):should_send(requests))
end

function test_queued_output_checks_deadline_and_poisoned_reply_endpoint(_context: test.Context)
  local tx, rx = thread.channel<|protocol.WorldReply|>(1)
  defer tx:close()
  local pending = world.Pending(protocol.WorldRequest("request", "entity", "{}", uv.hrtime() + 1000000000, tx), false, nil)
  local requests: {string: world.Pending} = {["request"] = pending}
  local message = world.Outgoing("request payload", "request")
  rx:close()
  test.assert(not message:should_send(requests), "cancelled reply lease admitted a queued mutation")
  local tx2, rx2 = thread.channel<|protocol.WorldReply|>(1)
  defer do rx2:close(); tx2:close() end
  requests["request"] = world.Pending(protocol.WorldRequest("request", "entity", "{}", uv.hrtime() - 1, tx2), false, nil)
  test.assert(not message:should_send(requests), "expired absolute deadline admitted a queued mutation")
end

function test_unsubscribe_compacts_the_subscriber_registry(_context: test.Context)
  local worlds = hub.Hub(128, 30000)
  defer worlds:close()
  local first = worlds:subscribe("world", "chat-events")
  defer worlds:unsubscribe(first.key)
  local second = worlds:subscribe("world", "chat-events")
  local third = worlds:subscribe("world", "hooks")
  defer worlds:unsubscribe(third.key)
  local fourth = worlds:subscribe("world", "chat-events")
  worlds:unsubscribe(second.key)
  worlds:unsubscribe(fourth.key)
  test.assert(#worlds.subscribers == 2 and worlds.subscribers[1].subscription.key == first.key and worlds.subscribers[2].subscription.key == third.key,
              "unsubscription retained holes or changed active subscriber order")
  test.assert(worlds:subscription_count("world", "chat-events") == 1 and
              worlds:subscription_count("world", "hooks") == 1,
              "unsubscription left incorrect per-channel counts")
end

function test_hub_shutdown_ends_waiters_and_stops_new_subscriptions(_context: test.Context)
  local worlds = hub.Hub(128, 30000)
  defer worlds:close()
  local subscriber = worlds:subscribe("world", "chat-events")
  defer worlds:unsubscribe(subscriber.key)
  local reading = async.run<|string?, value|>(function (): string?
    case subscriber.events:receive_result()
    when message(text) then return text
    when closed() then return nil
    end
  end)
  defer hub.drain(reading)
  while reading:status():as_string() == "ready" do timer.yield() end
  worlds:close()
  case async.join(reading)
  when succeeded(message) then test.assert(message == nil, "shutdown did not end an SSE waiter")
  when failed(failure) then failure:raise()
  else raise "SSE waiter did not retire after shutdown"
  end
  local selected?, problem? = worlds:select("world")
  test.assert(selected == nil and problem == "relay is closed" and not worlds:online("world"),
              "closed hub still admits world operations")
  local rejected = false
  do
    worlds:subscribe("world", "hooks")
  catch
    rejected = true
    test.assert(error == "relay is closed")
  end
  test.assert(rejected and #worlds.subscribers == 1,
              "closed hub accepted a new subscriber")
end

local record Address
  const handle: protocol.WorldHandle
  const requests: thread.Receiver<|protocol.WorldRequest|>
  const commands: thread.Receiver<|protocol.WorldCommand|>
  const health: thread.Sender<|nil|>
end

local function address(key: string): Address
  local requests, inbox = thread.channel<|protocol.WorldRequest|>(8)
  local commands, controls = thread.channel<|protocol.WorldCommand|>(8)
  local health, terminal = thread.channel<|nil|>(1)
  return Address(protocol.WorldHandle(key, "world", requests, commands, terminal), inbox, controls, health)
end

local function Address:close()
  self.health:close()
  self.requests:close()
  self.commands:close()
end

local function quiescence_ack(endpoint: Address): thread.Sender<|boolean|>
  case endpoint.commands:receive()
  when quiesce(_reason, ack) then return ack
  else raise "replacement did not ask its incumbent to quiesce"
  end
end

function test_replacement_selection_waits_for_local_quiescence(_context: test.Context)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local first = address("first")
  defer first:close()
  local second = address("second")
  defer second:close()
  local original, _snapshot = worlds:publish_authenticated(first.handle)
  local replacing = async.run<|hub.Session, value|>(function (): hub.Session
    local session, _activation = worlds:publish_authenticated(second.handle)
    return session
  end)
  defer do first:close(); second:close(); hub.drain(replacing) end
  local ack = quiescence_ack(first)
  local selecting = async.run<|hub.Session?, value|>(function (): hub.Session?
    local selected?, _problem? = worlds:select("world")
    return selected
  end)
  defer hub.drain(selecting)
  timer.yield()
  test.assert(not selecting:status():has_finished() and not original.closed,
    "selection observed an offline gap before the quiescence ACK")
  ack:send(true)
  local replacement: hub.Session? = nil
  case async.join(replacing)
  when succeeded(session) then replacement = session
  when failed(failure) then failure:raise()
  else raise "replacement admission did not finish"
  end
  case async.join(selecting)
  when succeeded(session) then test.assert(session == replacement)
  when failed(failure) then failure:raise()
  else raise "selection did not resume after publication"
  end
  worlds:retire("world", "first")
  test.assert(worlds:online("world"), "stale monitor removed its replacement")
  first.health:close()
  if original.retirement then
    case async.join(original.retirement)
    when succeeded() then
    when failed(failure) then failure:raise()
    else raise "incumbent retirement did not finish"
    end
  end
end

function test_cancelled_replacement_finishes_quiescence_without_publication(_context: test.Context)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local first = address("first")
  defer first:close()
  local second = address("second")
  defer second:close()
  local original, _snapshot = worlds:publish_authenticated(first.handle)
  local replacing = async.run<|nil, value|>(function (): nil
    worlds:publish_authenticated(second.handle)
    return nil
  end)
  defer do first:close(); second:close(); hub.drain(replacing) end
  local ack = quiescence_ack(first)
  replacing:cancel()
  ack:send(true)
  test.assert((async.join(replacing):has_cancelled()))
  test.assert(original.closed and not worlds:online("world"),
    "cancelled admission retained a quiesced incumbent or published its replacement")
  first.health:close()
  if original.retirement then
    case async.join(original.retirement)
    when succeeded() then
    when failed(failure) then failure:raise()
    else raise "cancelled admission stranded incumbent retirement"
    end
  end
end

function test_failed_quiescence_delivery_waits_for_joined_health(_context: test.Context)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local first = address("first")
  defer first:close()
  local second = address("second")
  defer second:close()
  worlds:publish_authenticated(first.handle)
  local replacing = async.run<|nil, value|>(function (): nil
    worlds:publish_authenticated(second.handle)
    return nil
  end)
  defer do first:close(); second:close(); hub.drain(replacing) end
  local ack = quiescence_ack(first)
  ack:close()
  timer.yield()
  timer.yield()
  test.assert(not replacing:status():has_finished(), "failed ACK delivery was accepted as quiescence")
  first.health:close()
  case async.join(replacing)
  when succeeded() then
  when failed(failure) then failure:raise()
  else raise "joined incumbent did not unblock admission"
  end
  local selected?, _problem? = worlds:select("world")
  test.assert(selected ~= nil and selected.world.key == "second")
end

function test_captured_close_holds_admission_until_quiescence_then_awaits_join(_context: test.Context)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local endpoint = address("captured")
  defer endpoint:close()
  local session, _activation = worlds:publish_authenticated(endpoint.handle)
  local closing = async.run<|nil, value|>(function (): nil session:close(); return nil end)
  defer do endpoint:close(); hub.drain(closing) end
  local ack = quiescence_ack(endpoint)
  local selecting = async.run<|hub.Session?, value|>(function (): hub.Session?
    local selected?, _problem? = worlds:select("world")
    return selected
  end)
  defer hub.drain(selecting)
  timer.yield()
  test.assert(not session.closed and not selecting:status():has_finished(),
    "captured close admitted a replacement before stopping world requests")
  ack:send(true)
  case endpoint.commands:receive()
  when stop(graceful) then test.assert(not graceful)
  else raise "captured close did not abort its quiesced transport"
  end
  case async.join(selecting)
  when succeeded(selected) then test.assert(selected == nil)
  when failed(failure) then failure:raise()
  else raise "selection did not resume after captured quiescence"
  end
  test.assert(not closing:status():has_finished(), "captured close returned before transport owner joined")
  endpoint.health:close()
  case async.join(closing)
  when succeeded() then
  when failed(failure) then failure:raise()
  else raise "captured close did not finish after owner join"
  end
end
