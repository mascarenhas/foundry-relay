local test = import "test"
local async = import "async"
local fs = import "fs"
local os = import "os"
local uv = import "uv"
local browser = import "relay.browser.titan"
local store = import "relay.store"
local foundry = import "relay.foundry_session.titan"
local hub = import "relay.hub.titan"
local world = import "relay.world.titan"
local protocol = import "relay.world_protocol"
local messages = import "relay.messages"
local config = import "relay.config"
local thread = import "thread"
local wire = import "relay.wire"
local browser_fixture = import "tests.browser_test.titan"
local cdp_fixture = import "tests.cdp_test.titan"

local record RelayFixture
  const peer: cdp_fixture.Fixture
  const session: hub.Session
  const engine: world.Engine
  local const release: function(boolean): ()
  local const close_release: function(): ()
  local closed: boolean
end

-- Keep the relay transport independent of browser cleanup. Only this channel
-- releases its peer, so browser exit cannot accidentally satisfy the assertion.
local function relay_fixture(worlds: hub.Hub, id: string?): RelayFixture
  local admit, admitted, close_admitted = async.channel<|hub.Session|>(1)
  defer close_admitted()
  local release, released, close_release = async.channel<|boolean|>(1)
  local transferred = false
  local engine: world.Engine? = nil
  defer if not transferred then close_release() end
  local peer = cdp_fixture.fixture(function(stream)
    local requests_tx, requests_rx = thread.channel<|protocol.WorldRequest|>(8)
    local commands_tx, commands_rx = thread.channel<|protocol.WorldCommand|>(8)
    local health_tx, health_rx = thread.channel<|nil|>(1)
    local inbox_tx, inbox_rx = thread.channel<|world.Opening|>(1)
    local ready_tx, ready_rx = thread.channel<|boolean|>(1)
    local control_tx, control_rx = thread.channel<|messages.ControlRequest|>(1)
    defer do
      requests_rx:close(); commands_rx:close(); inbox_rx:close(); ready_rx:close(); control_rx:close()
      requests_tx:close(); commands_tx:close(); inbox_tx:close(); ready_tx:close(); control_tx:close()
    end
    local key = store.secure_token(16)
    local handle = protocol.WorldHandle(key, id or "retirement-world", requests_tx, commands_tx, health_rx)
    local settings = config.Config("127.0.0.1", 0, "key", "CODE12", "/unused", "ws://127.0.0.1/relay", {}, 60000, 60000, 1000, 8, 1)
    local bootstrap = world.Bootstrap(1, settings, handle, requests_rx, commands_rx, inbox_rx, ready_tx, control_tx, "error", nil)
    engine = world.Engine(bootstrap, stream, nil)
    defer do engine:close(); engine.outbox:close() end
    local requests = async.run<|nil, value|>(engine:request_loop)
    defer hub.drain(requests)
    local owner = async.run<|nil, value|>(function (): nil
      -- This terminal signal follows actual native transport close and children.
      defer health_tx:close()
      defer hub.drain(requests)
      defer engine:close()
      return engine:command_loop()
    end)
    defer hub.drain(owner)
    local session, _activation = worlds:publish_authenticated(handle)
    admit(session)
    released()
  end)
  defer if not transferred then peer:close() end
  local session = admitted()
  transferred = true
  return RelayFixture(peer, session, engine, release, close_release, false)
end

local function RelayFixture:close()
  if self.closed then return end
  self.closed = true
  defer self.close_release()
  defer self.peer:close()
  self.release(true)
  self.peer:finish_peer()
end

local function empty_browser(): browser.Browser
  local directory = fs.tmpname()
  fs.unlink(directory)
  fs.mkdir(directory)
  -- Exercise the real portable retirement/profile path without a child or CDP
  -- owner. Process/CDP retirement also has an installed-Chromium case below.
  return browser.Browser(directory, nil, nil, nil, "", nil, nil, nil, false)
end

local function pending_request(fixture: RelayFixture): async.Task<|hub.Reply, value|>
  local requesting = async.run<|hub.Reply, value|>(function(): hub.Reply
    return fixture.session:request("world-info", {}, 60000)
  end)
  local transferred = false
  defer if not transferred then hub.drain(requesting) end
  -- Dequeuing the request synchronizes with its registered waiter, without a
  -- timer or scheduler polling. No writer sends it to the held relay peer.
  case fixture.engine.outbox:next()
  when item(_) then
  else raise "Retirement fixture did not enqueue its pending request"
  end
  transferred = true
  return requesting
end

local function assert_disconnected(requesting: async.Task<|hub.Reply, value|>)
  case async.join(requesting)
  when succeeded(reply) then
    test.assert(reply.status == 503, "Retirement did not fail the pending relay request")
  when failed(failure) then failure:raise()
  else raise "Retirement cancelled the pending relay request"
  end
end

local function assert_owned_relay_retirement(instance: browser.Browser)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local fixture = relay_fixture(worlds)
  defer fixture:close()
  local session_owner = foundry.Session(instance, fixture.session, fixture.session.id, {})
  defer session_owner:close()
  local requesting = pending_request(fixture)
  defer hub.drain(requesting)
  test.assert(worlds:online(fixture.session.id) and not fixture.peer.peer:status():has_finished())
  session_owner:close()
  test.assert(not worlds:online(fixture.session.id),
    "Browser retirement left its independent relay session online")
  test.assert(not fixture.peer.peer:status():has_finished(), "Relay peer was released by browser cleanup")
  test.assert(fixture.engine.closed and fixture.session.world.health:is_closed(),
    "Retirement reported offline before its independent transport owner finished")
  test.assert(not instance:running() and fs.lstat(instance:profile()) == nil,
    "Relay retirement skipped browser cleanup")
  assert_disconnected(requesting)
end

function test_session_close_retires_owned_relay_and_pending_request(_context: test.Context)
  local instance = empty_browser()
  defer instance:close()
  assert_owned_relay_retirement(instance)
end

function test_session_close_retires_owned_relay_with_installed_chromium(_context: test.Context)
  local executable = os.getenv("RELAY_TEST_CHROME") or ""
  local parent = os.getenv("RELAY_TEST_BROWSER_PROFILES") or ""
  if executable == "" or parent == "" then
    test.skip("capability: set RELAY_TEST_CHROME and RELAY_TEST_BROWSER_PROFILES for installed Chromium")
  end
  local instance = browser.start(executable, parent, true, 15000)
  defer instance:close()
  assert_owned_relay_retirement(instance)
end

function test_session_close_preserves_replacement_connection(_context: test.Context)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local original = relay_fixture(worlds)
  defer original:close()
  local replacement = relay_fixture(worlds)
  defer replacement:close()
  local instance = empty_browser()
  defer instance:close()
  local session_owner = foundry.Session(instance, original.session, original.session.id, {})
  session_owner:close()
  test.assert(original.session.closed, "Retirement left the captured predecessor open")
  test.assert(worlds:online(replacement.session.id) and
    foundry.owns_connection(worlds, replacement.session.id, replacement.session),
    "Retirement closed a replacement connection with the same client ID")
  test.assert(not replacement.peer.peer:status():has_finished(), "Replacement peer was released")
end

function test_session_close_runs_both_owners_after_browser_cleanup_failure(_context: test.Context)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local fixture = relay_fixture(worlds)
  defer fixture:close()
  local instance = empty_browser()
  defer browser.remove_profile(instance:profile())
  local release, released, close_release = async.channel<|boolean|>(1)
  defer close_release()
  local entered, started, close_started = async.channel<|boolean|>(1)
  defer close_started()
  local browser_retired = false
  -- Substitute only the Browser's existing retirement-task boundary: the
  -- yielding failure is portable and does not depend on filesystem permissions.
  local retirement = async.run<|async.Error?, value|>(function(): async.Error?
    released()
    browser.remove_profile(instance:profile())
    browser_retired = true
    return async.Error("Browser cleanup failed", "")
  end)
  instance.retirement = retirement
  defer hub.drain(retirement)
  local session_owner = foundry.Session(instance, fixture.session, fixture.session.id, {})
  local requesting = pending_request(fixture)
  defer hub.drain(requesting)
  local closing = async.run<|value, value|>(function(): value
    entered(true)
    session_owner:close()
    return nil
  catch return error
  end)
  defer hub.drain(closing)
  local released_cleanup = false
  local allow_cleanup = function()
    if not released_cleanup then
      released_cleanup = true
      release(true)
    end
  end
  -- Failure assertions must also release the shielded Browser owner before
  -- draining its caller, which deliberately waits for that owner's retirement.
  defer allow_cleanup()
  started()
  test.assert(worlds:online(fixture.session.id) and not browser_retired,
    "Relay retirement ran before browser cleanup completed")
  allow_cleanup()
  case async.join(closing)
  when succeeded(failure) then test.assert(failure == "Browser cleanup failed")
  when failed(failure) then failure:raise()
  else raise "Owned cleanup was cancelled"
  end
  test.assert(browser_retired and not worlds:online(fixture.session.id),
    "Browser cleanup failure skipped one of the owned resources")
  test.assert(not fixture.peer.peer:status():has_finished(), "Relay peer was released by browser cleanup")
  assert_disconnected(requesting)
end

local function paired(id: string, world: string, origin: string): store.Client
  return store.Client(id, "synthetic-token", world, "Test World", "fingerprint",
    origin, "3.4.1", "{}", 0)
end

function test_existing_pairing_requires_world_and_origin(_context: test.Context)
  local selected = foundry.existing_client({
    paired("other-world", "other", "https://example.test"),
    paired("other-origin", "sandbox", "https://other.test"),
    paired("expected", "sandbox", "https://example.test") },
    "sandbox", "https://example.test")
  test.assert(selected.client_id == "expected")
end

function test_missing_pairing_is_not_created(_context: test.Context)
  local rejected = false
  do foundry.existing_client({}, "sandbox", "https://example.test")
  catch
    rejected = true
    test.assert(error == "No existing pairing matches the Foundry world")
  end
  test.assert(rejected)
end

function test_ambiguous_pairing_is_rejected(_context: test.Context)
  local rejected = false
  do foundry.existing_client({paired("one", "sandbox", "https://example.test"),
    paired("two", "sandbox", "https://example.test")}, "sandbox", "https://example.test")
  catch
    rejected = true
    test.assert(error == "Multiple existing pairings match the Foundry world")
  end
  test.assert(rejected)
end

function test_omitted_world_requires_unique_pairing_at_origin(_context: test.Context)
  local selected = foundry.existing_client({
    paired("other-origin", "sandbox", "https://other.test"),
    paired("expected", "sandbox", "https://example.test") }, "", "https://example.test")
  test.assert(selected.client_id == "expected" and selected.world_id == "sandbox")
  local failure: value = nil
  do
    foundry.existing_client({paired("one", "one", "https://example.test"),
      paired("two", "two", "https://example.test")}, "", "https://example.test")
  catch failure = error
  end
  test.assert(failure == "Multiple existing pairings match the Foundry world",
    "Omitted world silently selected one of several paired worlds")
end

function test_world_title_resolves_to_concrete_paired_world(_context: test.Context)
  local selected = foundry.existing_client({paired("expected", "sandbox", "https://example.test")},
    "Test World", "https://example.test")
  test.assert(selected.world_id == "sandbox", "Display title did not resolve to the paired world id")
end

function test_world_information_publishes_only_documented_metadata(_context: test.Context)
  local response = hub.Reply(200, [[{"type":"world-info-result","requestId":"private",
    "data":{"world":{"id":"sandbox","title":"Test World"},
    "system":{"id":"test-system","title":"Test System","version":"1.2"},
    "foundryVersion":"14.1","modules":[{"id":"private-module"}],
    "users":[{"name":"private-user"}],"activeScene":{"id":"private-scene"}}}]])
  local metadata = foundry.session_metadata(response, "sandbox")
  test.assert(metadata["worldId"] == "sandbox" and metadata["worldTitle"] == "Test World")
  test.assert(metadata["systemId"] == "test-system" and metadata["systemTitle"] == "Test System" and
    metadata["systemVersion"] == "1.2" and metadata["foundryVersion"] == "14.1")
  test.assert(metadata["users"] == nil and metadata["modules"] == nil and
    metadata["activeScene"] == nil and metadata["requestId"] == nil)
end

local function rejected_information(body: string, expected: string)
  local failure: value = nil
  do foundry.session_metadata(hub.Reply(200, body), "sandbox")
  catch failure = error
  end
  test.assert(failure == expected, "Malformed or wrong-world information was accepted")
end

function test_world_information_requires_expected_world(context: test.Context)
  context:run("wrong world", function (_child: test.Context)
    rejected_information([[{"data":{"world":{"id":"other"},"system":{}}}]],
      "Foundry loaded a different world")
  end)
  context:run("missing data", function (_child: test.Context)
    rejected_information([[{}]], "Invalid Foundry world information")
  end)
  context:run("invalid system", function (_child: test.Context)
    rejected_information([[{"data":{"world":{"id":"sandbox"},"system":false}}]],
      "Invalid Foundry world information")
  end)
end

function test_readiness_uses_exact_hub_connection(_context: test.Context)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local admitted = relay_fixture(worlds, "paired")
  defer admitted:close()
  test.assert(foundry.owns_connection(worlds, "paired", admitted.session))
  local replacement = relay_fixture(worlds, "paired")
  defer replacement:close()
  test.assert(worlds:online("paired") and not foundry.owns_connection(worlds, "paired", admitted.session),
    "A replacement connection kept its predecessor's owned session ready")
  test.assert(foundry.owns_connection(worlds, "paired", replacement.session))
  local retired? = worlds:disconnect("paired")
  if retired then retired:close() end
  test.assert(not foundry.owns_connection(worlds, "paired", replacement.session))
end

function test_startup_budget_includes_browser_initialization(_context: test.Context)
  local process = browser_fixture.fixture([[port=$(cat "$parent/port")
printf '%s\n/devtools/browser/fixture\n' "$port" > "$profile/DevToolsActivePort"
exec /bin/sleep 30]])
  defer process:close()
  local peer = browser_fixture.browser_peer()
  defer peer:close()
  peer.acknowledge_page = false
  peer.expected_abort = true
  fs.write_file(process.directory .. "/port", "" .. peer.port)
  local worlds = hub.Hub(8, 60000)
  defer worlds:close()
  local client = paired("paired", "sandbox", "https://example.test")
  local options = foundry.Options { address = "https://example.test/", origin = "https://example.test",
    world = client.world_id, user = "Synthetic GM", password = "synthetic-password", client = client,
    relay_url = "ws://127.0.0.1:3010/relay" }
  local started = uv.hrtime()
  local failure: value = nil
  do foundry.start(options, process.executable, process.directory, worlds, 1000)
  catch failure = error
  end
  test.assert(failure == "Browser startup timed out", "Browser activation lost its deadline classification")
  test.assert((uv.hrtime() - started) // 1000000 < 6000,
    "Foundry's total startup budget did not include browser initialization")
  peer:finish()
  process:assert_reaped()
end

function test_startup_budget_rejects_expiration(_context: test.Context)
  local failure: value = nil
  do foundry.remaining(uv.hrtime() - 1000000, 5000)
  catch failure = error
  end
  test.assert(failure == "Foundry readiness timed out")
  test.assert(foundry.remaining(uv.hrtime() + 10000000000, 100) == 100,
    "Stage deadline exceeded its own cap")
end
