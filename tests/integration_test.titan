-- Exercise the executable's HTTP/WS boundary with small, protocol-compatible worlds.
local test = import "test"
local async = import "async"
local timer = import "timer"
local http = import "http"
local websocket = import "websocket"
local fs = import "fs"
local os = import "os"
local string = import "string"
local server = import "relay.server"
local config = import "relay.config"
local hub = import "relay.hub.titan"
local wire = import "relay.wire"

local const api_key = "integration-api-key"
local const pairing_code = "123ABC"

local record Fixture
  const instance: server.Server
  const serving: async.Task<|async.Error?, value|>
  const port: integer
  closed: boolean
end

local record Reply
  const status: integer
  const body: string
end

local record Credential
  const id: string
  const token: string
end

local function Fixture:close()
  if self.closed then return end
  self.closed = true
  self.instance:close()
  hub.drain(self.serving)
end

local function start(database: string, timeout: integer): Fixture
  local first_port = 42000 + (os.pid() % 100) * 100
  for port = first_port, first_port + 99 do
    local settings = config.Config {
      host = "127.0.0.1", port = port, api_key = api_key, pairing_code = pairing_code,
      database = database, public_url = "ws://127.0.0.1:" .. port .. "/relay",
      origins = {"http://127.0.0.1:30000"}, request_timeout = timeout,
      heartbeat = 60000, auth_timeout = 1000, max_pending = 16 }
    local instance = server.Server(settings)
    local failure: async.Error? = nil
    do
      -- DNS resolution can suspend before binding; await the public startup
      -- boundary before a caller attempts its first connection.
      instance:start()
    catch
      failure = async.Error(error, traceback)
    end
    if not failure then
      local serving = async.run<|async.Error?, value|>(function (): async.Error?
        instance:serve()
        return nil
      catch
        return async.Error(error, traceback)
      end)
      return Fixture(instance, serving, port, false)
    end
    instance:close()
    if failure.error is async.OperationError then
      local operation = failure.error as async.OperationError
      if operation.name ~= "EADDRINUSE" then failure:raise() end
    else
      failure:raise()
    end
  end
  raise "no available loopback port for relay tests"
end

local function with_relay(body: function(Fixture): ())
  local database = fs.tmpname()
  defer fs.unlink(database)
  local fixture = start(database, 3000)
  defer fixture:close()
  body(fixture)
end

local function read_all(reader: http.ClientResponse): string
  local output = string.writer()
  for chunk in reader:read do output:write(chunk) end
  return output:drain()
end

local function call(fixture: Fixture, method: string, path: string,
                    body: string?, key: string?): Reply
  local headers = http.headers()
  if key then headers:add("x-api-key", key) end
  if body then headers:add("Content-Type", "application/json") end
  local response = http.request(method, "http://127.0.0.1:" .. fixture.port .. path, headers, body)
  defer response:close()
  return Reply(response.status, read_all(response))
end

local function get(fixture: Fixture, path: string): Reply
  return call(fixture, "GET", path, nil, api_key)
end

local function request(fixture: Fixture, path: string): async.Task<|Reply, value|>
  return async.run<|Reply, value|>(function (): Reply return get(fixture, path) end)
end

local function await_reply(task: async.Task<|Reply, value|>): Reply
  case async.join(task)
  when succeeded(reply) then return reply
  when failed(failure) then failure:raise()
  else raise "HTTP task was cancelled"
  end
  raise "unreachable HTTP task status"
end

local function pair(fixture: Fixture, world: string): Credential
  local data: {string: value} = {
    ["code"] = pairing_code, ["worldId"] = world, ["worldTitle"] = world,
    ["serverFingerprint"] = "integration-foundry", ["serverOrigin"] = "http://127.0.0.1:30000" }
  local response = call(fixture, "POST", "/auth/pair", wire.encode(data), nil)
  test.assert(response.status == 200, "world pairing failed")
  local credentials = wire.object(response.body)
  test.assert(wire.text(credentials, "relayUrl") == fixture.instance.config.public_url)
  return Credential(wire.text(credentials, "clientId"), wire.text(credentials, "token"))
end

local function message(connection: websocket.Connection): {string: value}
  local kind?, contents? = connection:read()
  test.assert(kind == websocket.TEXT, "mock world did not receive a text message")
  return wire.object(contents)
end

local function dial(fixture: Fixture, credentials: Credential,
                    counts: ({string: integer})?): websocket.Connection
  local connection = websocket.connect("ws://127.0.0.1:" .. fixture.port ..
    "/relay?id=" .. credentials.id .. "&worldTitle=Integration&version=test",
    websocket.DialOptions {read_limit = 16777216, handshake_timeout = 2000})
  local auth: {string: value} = {["type"] = "auth", ["token"] = credentials.token}
  do
    connection:write(websocket.TEXT, wire.encode(auth))
    test.assert(wire.text(message(connection), "type") == "auth-success")
    local snapshot: {string: integer} = {}
    for index = 1, 6 do
      local update = message(connection)
      test.assert(wire.text(update, "type") == "event-subscription-update")
      local channel = wire.text(update, "channel")
      test.assert(snapshot[channel] == nil, "reconnect repeated a subscription channel")
      test.assert(update["count"] is integer, "subscription count was not an integer")
      snapshot[channel] = update["count"] as integer
    end
    local channels: const {string} = {"chat-events", "roll-events", "hooks",
                                     "combat-events", "actor-events", "scene-events"}
    for index = 1, #channels do
      local channel: string = channels[index]
      test.assert(snapshot[channel] ~= nil, "reconnect omitted a subscription channel")
      if counts then counts[channel] = snapshot[channel] end
    end
    -- A protocol round-trip proves Hub.run has installed the authenticated session.
    connection:write(websocket.TEXT, "{\"type\":\"ping\"}")
    test.assert(wire.text(message(connection), "type") == "pong")
    return connection
  catch
    connection:close()
    raise
  end
end

function test_reconnect_sends_normal_close_and_keeps_replacement_usable(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local incumbent = dial(fixture, credentials)
    defer incumbent:close()
    local pending = request(fixture, "/world-info")
    defer hub.drain(pending)
    message(incumbent)
    local reading = async.run<|nil, value|>(function (): nil
      local kind?, contents? = incumbent:read()
      test.assert(kind == nil and contents == nil, "replaced world did not receive a clean Close")
      local code?, reason? = incumbent:close_status()
      test.assert(code == 1000 and reason == "Replaced by reconnect",
                  "replaced world would retry after an abnormal disconnect")
      return nil
    end)
    defer hub.drain(reading)
    local replacement = dial(fixture, credentials)
    defer replacement:close()
    case async.join(reading)
    when succeeded(_) then
    when failed(failure) then failure:raise()
    else raise "incumbent reader did not finish"
    end
    test.assert(await_reply(pending).status == 503,
                "replacement left an incumbent's request unresolved")
    local current = request(fixture, "/world-info")
    defer hub.drain(current)
    answer(replacement, message(replacement), {["result"] = "replacement"})
    test.assert(wire.text(wire.object(await_reply(current).body), "result") == "replacement",
                "retiring incumbent removed its replacement")
  end)
end

function test_reconnect_retires_an_incumbent_that_never_reads_close(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local incumbent = dial(fixture, credentials)
    defer incumbent:close()
    local previous? = fixture.instance.worlds:select(credentials.id)
    test.assert(previous ~= nil)
    defer previous:close()
    -- No application reader answers the incumbent's Close. Admission and normal
    -- requests must proceed while its separate bounded shutdown owns retirement.
    local replacement = dial(fixture, credentials)
    defer replacement:close()
    local pending = request(fixture, "/world-info")
    defer hub.drain(pending)
    answer(replacement, message(replacement), {["result"] = "available"})
    test.assert(await_reply(pending).status == 200)
    local retirement? = previous.retirement
    test.assert(retirement ~= nil)
    local watchdog = async.run<|nil, value|>(function (): nil
      timer.sleep(3000)
      return nil
    end)
    defer hub.drain(watchdog)
    case async.any_two(retirement, watchdog)
    when first(_) then
    when second(_) then raise "nonresponsive incumbent outlived its bounded shutdown"
    else raise "incumbent retirement task did not complete"
    end
    test.assert(fixture.instance.worlds:online(credentials.id),
                "incumbent timeout aborted the replacement")
  end)
end

function test_reconnect_snapshot_includes_zero_counts_and_surviving_readers(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local incumbent = dial(fixture, credentials)
    defer incumbent:close()
    local retained = fixture.instance.worlds:subscribe(credentials.id, "chat-events")
    defer fixture.instance.worlds:unsubscribe(retained)
    local removed = fixture.instance.worlds:subscribe(credentials.id, "hooks")
    local chat = message(incumbent)
    local hooks = message(incumbent)
    test.assert(chat["count"] == 1 and hooks["count"] == 1)
    incumbent:close()
    while fixture.instance.worlds:online(credentials.id) do timer.yield() end
    fixture.instance.worlds:unsubscribe(removed)
    local snapshot: {string: integer} = {}
    local replacement = dial(fixture, credentials, snapshot)
    defer replacement:close()
    test.assert(snapshot["chat-events"] == 1, "reconnect lost a surviving SSE reader")
    test.assert(snapshot["hooks"] == 0, "reconnect retained a stale hook channel")
    test.assert(snapshot["roll-events"] == 0 and snapshot["combat-events"] == 0 and
                snapshot["actor-events"] == 0 and snapshot["scene-events"] == 0,
                "reconnect omitted an unused channel's explicit zero count")
  end)
end

function test_sse_overflow_immediately_disables_the_world_event_channel(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local world = dial(fixture, credentials)
    defer world:close()
    local stalled = fixture.instance.worlds:subscribe(credentials.id, "chat-events")
    defer fixture.instance.worlds:unsubscribe(stalled)
    test.assert(message(world)["count"] == 1)
    -- Keep the reader registered but consume no data, just like a stalled HTTP
    -- stream whose cleanup has not run. The overflow must notify Foundry itself.
    for index = 1, 129 do
      world:write(websocket.TEXT, "{\"type\":\"chat-event\",\"data\":{}}")
    end
    world:write(websocket.TEXT, "{\"type\":\"ping\"}")
    local update = message(world)
    test.assert(wire.text(update, "type") == "event-subscription-update" and
                wire.text(update, "channel") == "chat-events" and update["count"] == 0,
                "overflow left Foundry collecting an event channel without readers")
    test.assert(wire.text(message(world), "type") == "pong")
  end)
end

function test_cancelled_queued_mutation_detaches_before_deadline_cleanup(_context: test.Context)
  with_relay(function(fixture)
    local connection = dial(fixture, pair(fixture, "world"))
    defer connection:close()
    -- Hold output in an isolated Session with no writer, so cancellation can be
    -- observed before network admission while its real timer handle retires.
    local session = hub.Session.new("isolated", connection, 10)
    defer do session:close(); session.outbox:close() end
    local payload: {string: value} = {}
    local requesting = async.run<|hub.Reply, value|>(function (): hub.Reply
      return session:request("create", payload, 60000)
    end)
    defer hub.drain(requesting)
    while requesting:status():as_string() == "ready" do timer.yield() end
    timer.yield()
    local output = hub.Outgoing("queued mutation", wire.text(payload, "requestId"))
    test.assert(output:should_send(session.pending))
    requesting:cancel()
    local observing = async.run<|boolean, value|>(function (): boolean
      return output:should_send(session.pending)
    end)
    defer hub.drain(observing)
    case async.join(observing)
    when succeeded(eligible) then
      test.assert(not eligible, "cancelled mutation remained eligible while its deadline retired")
    when failed(failure) then failure:raise()
    else raise "queued request observer did not finish"
    end
    test.assert((async.join(requesting):has_cancelled()))
    test.assert(session.count == 0 and not output:should_send(session.pending))
  end)
end

local function answer(connection: websocket.Connection, request: {string: value},
                       fields: {string: value})
  fields["type"] = wire.text(request, "type") .. "-result"
  fields["requestId"] = wire.text(request, "requestId")
  connection:write(websocket.TEXT, wire.encode(fields))
end

function test_rest_authentication_and_public_health(_context: test.Context)
  with_relay(function(fixture)
    test.assert(call(fixture, "GET", "/health", nil, nil).status == 200)
    test.assert(call(fixture, "GET", "/clients", nil, nil).status == 401)
    test.assert(call(fixture, "GET", "/clients", nil, "wrong").status == 401)
    test.assert(get(fixture, "/clients").status == 200)
    local headers = http.headers({http.Header("x-api-key", api_key), http.Header("x-api-key", api_key)})
    local response = http.get("http://127.0.0.1:" .. fixture.port .. "/clients", headers)
    defer response:close()
    test.assert(response.status == 401, "duplicate API-key headers were accepted")
    local bad: {string: value} = {["code"] = "wrong", ["worldId"] = "world"}
    test.assert(call(fixture, "POST", "/auth/pair", wire.encode(bad), nil).status == 401)
  end)
end

function test_pairing_code_supports_two_worlds_and_explicit_routing(_context: test.Context)
  with_relay(function(fixture)
    local first_credentials = pair(fixture, "first-world")
    local second_credentials = pair(fixture, "second-world")
    test.assert(first_credentials.id ~= second_credentials.id)
    test.assert(first_credentials.token ~= second_credentials.token)
    local first = dial(fixture, first_credentials)
    defer first:close()
    local second = dial(fixture, second_credentials)
    defer second:close()
    test.assert(get(fixture, "/world-info").status == 400, "ambiguous default world was accepted")
    local listing = get(fixture, "/clients")
    local clients: {value} = wire.decode(listing.body)
    test.assert(#clients == 2)
    test.assert(not string.find(listing.body, first_credentials.token), "client listing exposed pairing token")
    local pending = request(fixture, "/world-info?clientId=" .. second_credentials.id)
    defer hub.drain(pending)
    local incoming = message(second)
    test.assert(wire.text(incoming, "type") == "world-info")
    test.assert(incoming["clientId"] == nil, "relay client ID leaked into action payload")
    answer(second, incoming, {["world"] = "second-world"})
    local response = await_reply(pending)
    test.assert(response.status == 200 and wire.text(wire.object(response.body), "world") == "second-world")
  end)
end

function test_single_world_is_default_and_pairing_is_stable(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local same = pair(fixture, "world")
    test.assert(credentials.id == same.id and credentials.token == same.token)
    local world = dial(fixture, credentials)
    defer world:close()
    local pending = request(fixture, "/world-info")
    defer hub.drain(pending)
    answer(world, message(world), {["world"] = "default"})
    local response = await_reply(pending)
    test.assert(response.status == 200 and wire.text(wire.object(response.body), "world") == "default")
  end)
end

function test_concurrent_http_requests_correlate_out_of_order_replies(_context: test.Context)
  with_relay(function(fixture)
    local world = dial(fixture, pair(fixture, "world"))
    defer world:close()
    local first = request(fixture, "/world-info?userId=first")
    defer hub.drain(first)
    local second = request(fixture, "/world-info?userId=second")
    defer hub.drain(second)
    local incoming_first = message(world)
    local incoming_second = message(world)
    test.assert(wire.text(incoming_first, "requestId") ~= wire.text(incoming_second, "requestId"))
    local early = incoming_second
    local late = incoming_first
    if wire.text(incoming_first, "userId") == "second" then early = incoming_first; late = incoming_second end
    answer(world, early, {["result"] = "second"})
    local second_reply = await_reply(second)
    test.assert(wire.text(wire.object(second_reply.body), "result") == "second")
    test.assert(not first:status():has_finished(), "reply completed another request's waiter")
    answer(world, late, {["result"] = "first"})
    test.assert(wire.text(wire.object(await_reply(first).body), "result") == "first")
  end)
end

function test_wrong_client_pairing_token_is_rejected(_context: test.Context)
  with_relay(function(fixture)
    local first = pair(fixture, "first")
    local second = pair(fixture, "second")
    local connection = websocket.connect("ws://127.0.0.1:" .. fixture.port .. "/relay?id=" .. first.id)
    defer connection:close()
    local auth: {string: value} = {["type"] = "auth", ["token"] = second.token}
    connection:write(websocket.TEXT, wire.encode(auth))
    test.assert(wire.text(message(connection), "type") == "auth-failed")
    local kind? = connection:read()
    test.assert(kind == nil)
    local code? = connection:close_status()
    test.assert(code == 1008, "wrong-token session did not close with a policy violation")
    test.assert(not fixture.instance.worlds:online(first.id))
  end)
end

function test_disconnect_settles_pending_http_request(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local world = dial(fixture, credentials)
    defer world:close()
    local pending = request(fixture, "/world-info")
    defer hub.drain(pending)
    message(world) -- The relay has admitted and forwarded this request.
    world:close()
    test.assert(await_reply(pending).status == 503, "disconnect left a pending request unresolved")
    test.assert(get(fixture, "/world-info?clientId=" .. credentials.id).status == 503)
  end)
end

function test_request_timeout_releases_waiter_and_session_remains_usable(_context: test.Context)
  local database = fs.tmpname()
  defer fs.unlink(database)
  local fixture = start(database, 100)
  defer fixture:close()
  local world = dial(fixture, pair(fixture, "world"))
  defer world:close()
  local pending = request(fixture, "/world-info")
  defer hub.drain(pending)
  local expired = message(world)
  test.assert(await_reply(pending).status == 408)
  -- An expired response cannot steal the next request's waiter.
  answer(world, expired, {["result"] = "too late"})
  local next = request(fixture, "/world-info")
  defer hub.drain(next)
  answer(world, message(world), {["result"] = "current"})
  local response = await_reply(next)
  test.assert(response.status == 200 and wire.text(wire.object(response.body), "result") == "current")
end

function test_credentials_survive_relay_restart(_context: test.Context)
  local database = fs.tmpname()
  defer fs.unlink(database)
  local first = start(database, 3000)
  defer first:close()
  local credentials = pair(first, "persistent-world")
  first:close()
  local second = start(database, 3000)
  defer second:close()
  local clients: {value} = wire.decode(get(second, "/clients").body)
  test.assert(#clients == 1)
  local world = dial(second, credentials)
  defer world:close()
  local pending = request(second, "/world-info?clientId=" .. credentials.id)
  defer hub.drain(pending)
  answer(world, message(world), {["result"] = "reconnected"})
  test.assert(wire.text(wire.object(await_reply(pending).body), "result") == "reconnected")
end

function test_large_json_round_trip_uses_fragmented_websocket_messages(_context: test.Context)
  with_relay(function(fixture)
    local world = dial(fixture, pair(fixture, "world"))
    defer world:close()
    local content = string.rep("🌑 quoted\" slash\\ newline\n", 4096)
    local payload: {string: value} = {["content"] = content}
    local pending = async.run<|Reply, value|>(function (): Reply
      return call(fixture, "POST", "/chat", wire.encode(payload), api_key)
    end)
    defer hub.drain(pending)
    local incoming = message(world)
    test.assert(wire.text(incoming, "type") == "chat-send")
    test.assert(wire.text(incoming, "content") == content, "fragmented request JSON changed bytes")
    answer(world, incoming, {["content"] = content})
    local response = await_reply(pending)
    test.assert(response.status == 200)
    test.assert(wire.text(wire.object(response.body), "content") == content, "fragmented reply JSON changed bytes")
  end)
end

function test_websocket_ping_and_application_ping_keep_session_live(_context: test.Context)
  with_relay(function(fixture)
    local world = dial(fixture, pair(fixture, "world"))
    defer world:close()
    local reading = async.run<|{string: value}, value|>(function (): {string: value} return message(world) end)
    defer hub.drain(reading)
    world:ping(1000) -- Both peers have application readers to service control frames.
    world:write(websocket.TEXT, "{\"type\":\"ping\"}")
    case async.join(reading)
    when succeeded(reply) then test.assert(wire.text(reply, "type") == "pong")
    when failed(failure) then failure:raise()
    else raise "ping reader did not succeed"
    end
  end)
end

function test_sse_subscription_update_and_event_data(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local world = dial(fixture, credentials)
    defer world:close()
    local headers = http.headers({http.Header("x-api-key", api_key)})
    local response = http.get("http://127.0.0.1:" .. fixture.port .. "/chat/subscribe?clientId=" .. credentials.id, headers)
    defer response:close()
    test.assert(response.status == 200 and response.headers:get("Content-Type") == "text/event-stream")
    local connected = response:read_until("\n\n", true)
    test.assert(string.sub(connected, 1, 17) == "event: connected\n")
    local subscription = message(world)
    test.assert(wire.text(subscription, "type") == "event-subscription-update")
    test.assert(wire.text(subscription, "channel") == "chat-events")
    test.assert(subscription["count"] == 1)
    local event_data: {string: value} = {["eventType"] = "update", ["id"] = "mock-message", ["content"] = "line one\nline two"}
    local event: {string: value} = {["type"] = "chat-event", ["data"] = event_data}
    world:write(websocket.TEXT, wire.encode(event))
    local received = response:read_until("\n\n", true)
    test.assert(string.sub(received, 1, 19) == "event: chat-update\n")
    local data_start? = string.find(received, "data: ")
    test.assert(data_start ~= nil)
    local decoded = wire.object(string.sub(received, data_start + 6))
    test.assert(wire.text(decoded, "id") == "mock-message")
    test.assert(wire.text(decoded, "content") == "line one\nline two")
    -- Finish the subscriber before releasing its HTTP stream; no idle write is needed.
    fixture.instance.worlds:close()
  end)
end

function test_sse_client_disconnect_retires_subscription(_context: test.Context)
  with_relay(function(fixture)
    local credentials = pair(fixture, "world")
    local world = dial(fixture, credentials)
    defer world:close()
    local response = http.get("http://127.0.0.1:" .. fixture.port .. "/chat/subscribe?clientId=" .. credentials.id,
      http.headers({http.Header("x-api-key", api_key)}))
    defer response:close()
    test.assert(response.status == 200)
    response:read_until("\n\n", true)
    test.assert(message(world)["count"] == 1)
    response:close()
    local sending = async.run<|nil, value|>(function (): nil
      for index = 1, 128 do
        world:write(websocket.TEXT, [[{"type":"chat-event","data":{"eventType":"update","id":"scratch"}}]])
        timer.sleep(0)
      end
      return nil
    end)
    defer hub.drain(sending)
    local removed = message(world)
    test.assert(wire.text(removed, "channel") == "chat-events" and removed["count"] == 0,
      "closed SSE client retained its subscription")
    test.assert(async.join(sending):has_succeeded(), "SSE event producer did not finish")
    local counts: {string: integer} = {}
    local replacement = dial(fixture, credentials, counts)
    defer replacement:close()
    test.assert(counts["chat-events"] == 0, "reconnect retained the disconnected HTTP subscriber")
  end)
end
