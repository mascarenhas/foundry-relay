-- The relay process: the mk application, the parent-owned world directory,
-- headless sessions, and the coordinator that workers ask for shared state.
local async = import "async"
local thread = import "thread"
local iteration = import "iteration"
local string = import "string"
local mk = import "mk"
local log = import "mk.log"
local config = import "relay.config"
local wire = import "relay.wire"
local routes = import "relay.routes"
local store = import "relay.store"
local hub = import "relay.hub"
local world = import "relay.world"
local protocol = import "relay.world_protocol"
local messages = import "relay.messages"
local tasks = import "relay.tasks"
local sessions = import "relay.sessions"
local foundry = import "relay.foundry_session"

-- A published world's parent-owned endpoints. Its health Sender closes only
-- after the session worker's OS join (`Server:world_exited`).
local record WorldSlot
  const session_key: string
  const client_id: string
  const worker_id: integer
  const handle: protocol.WorldHandle
  const health: thread.Sender<|nil|>
  const requests: thread.Receiver<|protocol.WorldRequest|>
  const commands: thread.Receiver<|protocol.WorldCommand|>
end

local record Operation
  const worker_id: integer
  const task: async.Task<|nil, value|>
end

local record Provisional
  const worker_id: integer
  const entry: sessions.Entry
end

local record Unclaimed
  const worker_id: integer
  const subscription: protocol.Subscription
end

record Server
  const config: config.Config
  const worlds: hub.Hub
  local const app: mk.App
  local const database: store.Store
  local const headless: sessions.Manager
  local const logger: log.Logger?
  local closed: boolean
  local started: boolean
  local released: boolean
  local const world_slots: {string: WorldSlot}
  local const operations: {string: Operation}
  local const provisional: {string: Provisional}
  local const unclaimed: {string: Unclaimed}
  local const controls: thread.Sender<|messages.ControlRequest|>
  local const control_inbox: thread.Receiver<|messages.ControlRequest|>
  local control_task: async.Task<|nil, value|>?
  local retirement: async.Task<|async.Error?, value|>?
  local failure: async.Error?
  local cleanup_failure: async.Error?
end

local const withdrawn = "Foundry world disconnected"

function Server.new(settings: config.Config, headless_options: sessions.Options?,
    launcher: (function(foundry.Options, string, string, hub.Hub, integer): sessions.Client)?,
    logger: log.Logger?): Server
  if settings.api_concurrency < 1 then raise "invalid RELAY_API_CONCURRENCY" end
  local worlds = hub.Hub(settings.max_pending, settings.heartbeat, logger)
  local database = store.open(settings.database)
  local published = false
  defer if not published then database:close(); worlds:close() end
  local headless = sessions.Manager(headless_options or sessions.settings(), database, worlds,
    settings.public_url, settings.origins, launcher, logger)
  local controls, control_inbox = thread.channel<|messages.ControlRequest|>(256)
  local owner: Server? = nil
  local app = routes.create(settings, controls, logger, function (session_id: string, worker_id: integer, _: boolean)
    local server? = owner
    if server ~= nil then server:world_exited(session_id, worker_id) end
  end)
  local result: Server = {config = settings, worlds = worlds, app = app, database = database,
    headless = headless, logger = logger, closed = false, started = false, released = false,
    world_slots = {}, operations = {}, provisional = {}, unclaimed = {},
    controls = controls, control_inbox = control_inbox, control_task = nil,
    retirement = nil, failure = nil, cleanup_failure = nil}
  owner = result
  -- Each shutdown phase guards its own resources; mk runs pre-shutdown after
  -- the listener closed and post-shutdown after every worker joined.
  app:hooks():on_pre_shutdown(function () result:close_admission() end)
  app:hooks():on_post_shutdown(function (_: async.Error?) result:release() end)
  published = true
  return result
end

local const ack_reply = messages.ControlReply.ack()

local function error_reply(status: integer, text: string): messages.ControlReply
  return messages.ControlReply.response(status, wire.error_body(text))
end

local function Server:guard(step: function (): ())
  do step()
  catch if not self.cleanup_failure then self.cleanup_failure = async.Error(error, traceback) end
  end
end

local function Server:discard_provisional(key: string, worker_id: integer)
  local pending? = self.provisional[key]
  if not pending or pending.worker_id ~= worker_id then return end
  self.provisional[key] = nil
  self.headless:discard(pending.entry)
end

--- The session worker serving `client_id`'s published world, if any.
function Server:world_worker_id(client_id: string): integer?
  local selected?, _problem? = self.worlds:select(client_id)
  if selected == nil then return nil end
  local slot? = self.world_slots[selected.world.key]
  if slot == nil then return nil end
  local info? = self.app:session_worker(slot.session_key)
  if info == nil then return nil end
  return info.id
end

-- Detach a registered world whose publication failed and stop its worker
-- without joining it; `world_exited` finishes after the OS join.
local function Server:abandon_world(key: string)
  local slot? = self.world_slots[key]
  if slot == nil then return end
  self.worlds:retire(slot.client_id, key)
  do slot.handle.commands:try_send(protocol.WorldCommand.stop(false)) catch end
  slot.requests:close()
  slot.commands:close()
  self.app:stop_worker(slot.worker_id)
end

--- Session `on_exit`: the world worker joined, so its health may close.
local function Server:world_exited(session_id: string, worker_id: integer)
  local key, _client = world.split_session(session_id)
  local slot? = self.world_slots[key]
  if slot == nil or slot.worker_id ~= worker_id then return end
  -- Health closure may wake quiescence while its caller holds the Hub gate.
  slot.health:close()
  slot.requests:close()
  slot.commands:close()
  slot.handle.requests:close()
  slot.handle.commands:close()
  self.worlds:retire(slot.client_id, key)
  self.world_slots[key] = nil
end

-- Credential check, worker validation, registration, and publication run in
-- one Hub transition, so revoked credentials cannot publish after waiting.
local function Server:publish_world(request: messages.ControlRequest, session_key: string,
                                    opening_key: string, client_id: string,
                                    token: string): messages.ControlReply
  return self.worlds:transition<|messages.ControlReply|>(function (): messages.ControlReply
    local client? = self.database:authenticate(client_id, token)
    if not client then return error_reply(401, "invalid pairing token") end
    -- No yield from here until the slot is registered.
    local reply? = request.reply
    local info? = self.app:session_worker(session_key)
    if self.closed or info == nil or info.id ~= request.worker_id or not info.alive or
        self.world_slots[opening_key] ~= nil or reply == nil or reply:is_closed() then
      return error_reply(503, withdrawn)
    end
    local requests_tx, requests_rx = thread.channel<|protocol.WorldRequest|>(self.config.max_pending)
    local commands_tx, commands_rx = thread.channel<|protocol.WorldCommand|>(256)
    local health_tx, health_rx = thread.channel<|nil|>(1)
    local handle = protocol.WorldHandle(opening_key, client_id, requests_tx, commands_tx, health_rx)
    self.world_slots[opening_key] = WorldSlot(session_key, client_id, request.worker_id, handle,
      health_tx, requests_rx, commands_rx)
    local publishable = function (): boolean
      local current? = self.app:session_worker(session_key)
      local sender? = request.reply
      return not self.closed and not health_rx:is_closed() and current ~= nil and
        current.id == request.worker_id and current.alive and sender ~= nil and not sender:is_closed()
    end
    local activation: protocol.Activation? = nil
    do
      local _, snapshot = self.worlds:publish_authenticated(handle, publishable)
      activation = snapshot
    catch
      self:abandon_world(opening_key)
      if error == withdrawn then return error_reply(503, withdrawn) end
      raise
    end
    return messages.ControlReply.published(activation, handle, requests_rx, commands_rx)
  end)
end

local function Server:retire_credential(is_revoke: boolean, target: string): messages.ControlReply
  async.checkpoint()
  local response: messages.ControlReply? = nil
  local failure: async.Error? = nil
  -- An accepted native COMMIT can finish even when its waiter is cancelled.
  -- Once admitted, the complete credential/disconnect transition owns its
  -- lifetime independently of the API request that must wait for retirement.
  local changing = async.run<|nil, value|>(function (): nil
    local retired: hub.Session? = nil
    response = self.worlds:transition<|messages.ControlReply|>(function (): messages.ControlReply
      local id: string? = nil
      if is_revoke then
        id = self.database:revoke(target)
        if not id then return error_reply(401, "invalid pairing token") end
        log.emit(self.logger, "info", "pairing_revoked", {["client_id"] = id})
      else
        id = target
        if not self.database:remove(id) then return error_reply(404, "unknown client") end
        log.emit(self.logger, "info", "client_removed", {["client_id"] = id})
      end
      retired = self.worlds:disconnect(id)
      return messages.ControlReply.response(200, "{\"success\":true}")
    end)
    if retired then retired:close() end
    return nil
  catch
    failure = async.Error(error, traceback)
    return nil
  end)
  tasks.await_terminal(changing)
  if failure then failure:raise() end
  return response
end

local function Server:coordinate(request: messages.ControlRequest): messages.ControlReply
  case request.action
  when session_discard(key) then
    self:discard_provisional(key, request.worker_id)
    return ack_reply
  when unsubscribe(key) then
    self.worlds:unsubscribe(key)
    return ack_reply
  else
  end
  if self.closed then return error_reply(503, "relay is closed") end
  case request.action
  when auth_publish(session_key, opening_key, client_id, token) then
    return self:publish_world(request, session_key, opening_key, client_id, token)
  when online() then
    return messages.ControlReply.online_ids(self.worlds:online_ids())
  when is_online(client_id) then
    return messages.ControlReply.active(self.worlds:online(client_id))
  when select(client_id) then
    local selected?, problem? = self.worlds:select(client_id)
    if not selected then
      local status = problem == "multiple worlds are online; specify clientId" and 400 or 503
      return error_reply(status, problem)
    end
    return messages.ControlReply.selected(selected.world)
  when subscribe(client_id, channel) then
    return self.worlds:transition<|messages.ControlReply|>(function (): messages.ControlReply
      local selected?, problem? = self.worlds:select(client_id)
      if not selected then return error_reply(503, problem) end
      local subscription = self.worlds:subscribe(selected.id, channel)
      self.unclaimed[request.request_id] = Unclaimed(request.worker_id, subscription)
      return messages.ControlReply.subscribed(selected.world, subscription)
    end)
  when revoke(token) then
    return self:retire_credential(true, token)
  when delete_client(client_id) then
    return self:retire_credential(false, client_id)
  when session_handshake(address, user, world) then
    local result = self.headless:handshake(address, user, world)
    return messages.ControlReply.response(200, wire.encode(result))
  when session_start(key, body_json) then
    if key == "" or self.provisional[key] then return error_reply(400, "invalid session request") end
    local data = wire.object(body_json)
    local entry = self.worlds:transition<|sessions.Entry|>(function (): sessions.Entry
      return self.headless:begin(data)
    end)
    self.provisional[key] = Provisional(request.worker_id, entry)
    local delivered = false
    defer if not delivered then self:discard_provisional(key, request.worker_id) end
    self.headless:ready(entry)
    if request.reply and request.reply:is_closed() then return error_reply(503, "session request cancelled") end
    delivered = true
    local result: {string: value} = {["success"] = true, ["sessionId"] = entry.session_id,
      ["clientId"] = entry.client_id}
    return messages.ControlReply.response(200, wire.encode(result))
  when session_publish(key) then
    local pending? = self.provisional[key]
    if not pending or pending.worker_id ~= request.worker_id then
      return error_reply(503, "session is no longer available")
    end
    self.headless:publish(pending.entry)
    self.provisional[key] = nil
    return ack_reply
  when session_end(id) then
    if id == "" then return error_reply(400, "sessionId is required") end
    self.headless:finish(id)
    return messages.ControlReply.response(200, "{\"status\":\"ok\",\"message\":\"Session ended\"}")
  when session_list() then
    return messages.ControlReply.response(200, wire.encode(self.headless:list()))
  else
    return ack_reply
  end
catch
  if error is sessions.Error then
    local failure: sessions.Error = error
    return error_reply(failure.status, failure.message)
  end
  if error is async.CancellationReason then return error_reply(503, "request cancelled") end
  log.emit(self.logger, "error", "http_request_failed", {["reason"] = "coordinator_failure"})
  return error_reply(400, "invalid request")
end

local function Server:control_loop(): nil
  for _, request in self.control_inbox:incoming() do
    case request.action
    when claim() then
      local unclaimed? = self.unclaimed[request.request_id]
      if unclaimed and unclaimed.worker_id == request.worker_id then
        self.unclaimed[request.request_id] = nil
      end
    when cancel() then
      local pending? = self.operations[request.request_id]
      if pending and pending.worker_id == request.worker_id then pending.task:cancel() end
      local unclaimed? = self.unclaimed[request.request_id]
      if unclaimed and unclaimed.worker_id == request.worker_id then
        self.unclaimed[request.request_id] = nil
        self.worlds:unsubscribe(unclaimed.subscription.key)
      end
    else
      local id = request.request_id
      local working = async.run<|nil, value|>(function (): nil
        defer self.operations[id] = nil
        local result = self:coordinate(request)
        if request.reply then
          local accepted = false
          do accepted = request.reply:try_send(result) catch end
          if not accepted then
            case request.action
            when session_start(request_key, _) then
              self:discard_provisional(request_key, request.worker_id)
            end
            case result
            when subscribed(_, subscription) then
              self.unclaimed[id] = nil
              self.worlds:unsubscribe(subscription.key)
            when published(_, handle) then
              self:abandon_world(handle.key)
            end
          end
        end
        return nil
      end)
      self.operations[id] = Operation(request.worker_id, working)
    end
  end
  return nil
catch
  self.controls:close()
  self.failure = async.Error(error, traceback)
  self.app:initiate_shutdown()
  return nil
end

local function listen_address(host: string, port: integer): string
  if string.find(host, ":") then return "[" .. host .. "]:" .. port end
  return host .. ":" .. port
end

function Server:start()
  if self.closed then raise "relay server is closed" end
  if self.started then return end
  self.started = true
  local published = false
  defer if not published then self:close() end
  self.control_task = async.run<|nil, value|>(self:control_loop)
  self.app:start(listen_address(self.config.host, self.config.port))
  published = true
end

--- Serve until shutdown. A pool worker or coordinator failure shuts the
-- relay down and is raised here.
function Server:serve()
  self:start()
  do self.app:serve()
  catch if not self.failure then self.failure = async.Error(error, traceback) end
  end
  self:close()
  if self.failure then self.failure:raise() end
end

local function drain_operations(ops: {string: Operation}, cancel: boolean)
  local list: {async.Task<|nil, value|>} = {}
  for _, pending in iteration.pairs(ops) do list[#list + 1] = pending.task end
  if cancel then
    for index = 1, #list do list[index]:cancel() end
  end
  for index = 1, #list do tasks.await_terminal(list[index]) end
end

-- Pre-shutdown (listener closed): end coordinator work and retire worlds.
-- Workers are still alive, so world engines answer quiescence themselves.
local function Server:close_admission()
  self.closed = true
  drain_operations(self.operations, true)
  self:guard(function () self.headless:close() end)
  self:guard(function () self.worlds:close() end)
  for id, _ in iteration.pairs(self.unclaimed) do self.unclaimed[id] = nil end
end

-- Post-shutdown (every worker joined): release coordinator-owned state.
local function Server:release()
  if self.released then return end
  self.released = true
  local pending_keys: {string} = {}
  for key, _ in iteration.pairs(self.provisional) do pending_keys[#pending_keys + 1] = key end
  for index = 1, #pending_keys do
    local key = pending_keys[index]
    local pending? = self.provisional[key]
    if pending then self:guard(function () self:discard_provisional(key, pending.worker_id) end) end
  end
  self.controls:close()
  local control_task? = self.control_task
  if control_task then tasks.await_terminal(control_task) end
  drain_operations(self.operations, false)
  self.control_inbox:close()
  self:guard(function () self.database:close() end)
end

local function Server:shutdown(): async.Error?
  self.closed = true
  self:guard(function () self.app:shutdown() end)
  -- The hooks ran inside mk's shutdown; release() is idempotent.
  self:release()
  return self.cleanup_failure
end

local function Server:begin_close()
  if self.retirement then return end
  self.closed = true
  self.retirement = async.run<|async.Error?, value|>(self:shutdown)
end

function Server:close()
  if self.retirement and self.retirement:status():has_finished() then return end
  self:begin_close()
  tasks.await_retirement(self.retirement, "relay shutdown cancelled")
end
