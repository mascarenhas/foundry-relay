-- REST handlers. They run on mk pool workers; each worker state attaches its
-- own Store and reply pool in on_start and asks the coordinator for state it
-- does not own.
local async = import "async"
local iteration = import "iteration"
local string = import "string"
local thread = import "thread"
local timer = import "timer"
local mk = import "mk"
local log = import "mk.log"
local api = import "relay.api"
local config = import "relay.config"
local control = import "relay.control"
local messages = import "relay.messages"
local protocol = import "relay.world_protocol"
local replies = import "relay.replies"
local store = import "relay.store"
local tasks = import "relay.tasks"
local wire = import "relay.wire"

-- Per worker state: every pool worker is an independent Lua state.
local record State
  const worker_id: integer
  const settings: config.Config
  const database: store.Store
  const coordinator: thread.Sender<|messages.ControlRequest|>
  const pool: replies.Pool
  const logger: log.Logger?
end

local state: State? = nil

local const online_action = messages.ControlAction.online()
local const session_list_action = messages.ControlAction.session_list()

--- Worker initializer: attach the Store and reply pool for this worker.
function initializer(settings: config.Config,
                     coordinator: thread.Sender<|messages.ControlRequest|>): mk.WorkerInit
  return function (wctx: mk.WorkerContext)
    local database = store.attach(settings.database)
    local pool = replies.Pool(4, wctx.logger)
    state = State(wctx.id, settings, database, coordinator, pool, wctx.logger)
    wctx:defer_cleanup(function ()
      state = nil
      pool:close()
      database:close()
    end)
  end
end

local function current(): State
  local initialized? = state
  if initialized == nil then raise "API worker is not initialized" end
  return initialized
end

--- Write a JSON response body.
function json_response(ctx: mk.Context, status: integer, body: string)
  ctx:status(status):set("Content-Type", "application/json; charset=utf-8"):send(body)
end

--- Write `{"error": message}`.
function error_response(ctx: mk.Context, status: integer, message: string)
  json_response(ctx, status, wire.error_body(message))
end

local function ask(action: messages.ControlAction): messages.ControlReply
  local worker = current()
  return control.call(worker.coordinator, worker.worker_id, action)
end

local function write_reply(ctx: mk.Context, reply: messages.ControlReply)
  case reply
  when response(status, body) then json_response(ctx, status, body)
  else error_response(ctx, 500, "unexpected coordinator reply")
  end
end

-- An empty body is {} without requiring a JSON Content-Type.
local function json_body(ctx: mk.Context): {string: value}
  local source = ctx:body()
  if source == "" then return {} end
  if not ctx:is_json() then raise "request body must use application/json" end
  return wire.object(source)
end

function health(ctx: mk.Context)
  json_response(ctx, 200, "{\"status\":\"ok\"}")
end

function pair(ctx: mk.Context)
  local worker = current()
  local data = json_body(ctx)
  local code = wire.text(data, "code")
  if not config.secret_equal(code, worker.settings.pairing_code) then
    error_response(ctx, 401, "invalid pairing code")
    return
  end
  local world_id = wire.text(data, "worldId")
  if world_id == "" then error_response(ctx, 400, "worldId is required"); return end
  local client = worker.database:pair(world_id, wire.text(data, "worldTitle", world_id),
    wire.text(data, "serverFingerprint"), wire.text(data, "serverOrigin"), wire.text(data, "existingClientId"))
  log.emit(worker.logger, "info", "pairing_created", {["client_id"] = client.client_id})
  local result: {string: value} = { ["token"] = client.token, ["clientId"] = client.client_id,
    ["relayUrl"] = worker.settings.public_url }
  json_response(ctx, 200, wire.encode(result))
end

function unpair(ctx: mk.Context)
  local data = json_body(ctx)
  write_reply(ctx, ask(messages.ControlAction.revoke(wire.text(data, "token"))))
end

function active(ctx: mk.Context)
  local id = ctx:param("clientId")
  if not current().database:get(id) then error_response(ctx, 404, "unknown client"); return end
  case ask(messages.ControlAction.is_online(id))
  when active(is_active) then
    json_response(ctx, 200, is_active and "{\"active\":true}" or "{\"active\":false}")
  when response(status, reply_body) then json_response(ctx, status, reply_body)
  else error_response(ctx, 500, "unexpected coordinator reply")
  end
end

function clients(ctx: mk.Context)
  local paired = current().database:list()
  local online: {string: boolean} = {}
  case ask(online_action)
  when online_ids(ids) then
    for index = 1, #ids do online[ids[index]] = true end
  when response(status, body) then
    json_response(ctx, status, body)
    return
  else
    error_response(ctx, 500, "unexpected coordinator reply")
    return
  end
  local results: {value} = {}
  for index = 1, #paired do
    local client = paired[index]
    local metadata = wire.object(client.metadata_json)
    local item: {string: value} = {["id"] = client.client_id, ["clientId"] = client.client_id,
      ["worldId"] = client.world_id, ["worldTitle"] = client.world_title,
      ["version"] = client.module_version, ["lastSeen"] = client.last_seen,
      ["connected"] = online[client.client_id] == true}
    for key, content in iteration.pairs(metadata) do
      if key ~= "id" and key ~= "token" and key ~= "clientId" and key ~= "connected" then item[key] = content end
    end
    results[index] = item
  end
  json_response(ctx, 200, wire.encode(results))
end

function forget(ctx: mk.Context)
  write_reply(ctx, ask(messages.ControlAction.delete_client(ctx:param("clientId"))))
end

local function wait_keepalive(): nil
  timer.sleep(15000)
  return nil
end

local function sse_name(channel: string, data: {string: value}): string
  if channel == "roll-events" then return "roll" end
  if channel == "hooks" then
    local name = wire.text(data, "hook", wire.text(data, "hookName", "hook"))
    if string.find(name, "\n") or string.find(name, "\r") then return "event" end
    return name
  end
  local prefix = "chat"
  if channel == "combat-events" then prefix = "combat"
  elseif channel == "actor-events" then prefix = "actor"
  elseif channel == "scene-events" then prefix = "scene"
  end
  local name = prefix .. "-" .. wire.text(data, "eventType", "create")
  if string.find(name, "\n") or string.find(name, "\r") then return prefix end
  return name
end

local function serve_stream(ctx: mk.Context, channel: string)
  local worker = current()
  local subscription: protocol.Subscription? = nil
  case ask(messages.ControlAction.subscribe(ctx:query("clientId", ""), channel))
  when subscribed(_, sub) then subscription = sub
  when response(status, body) then json_response(ctx, status, body); return
  else error_response(ctx, 500, "unexpected coordinator reply"); return
  end
  defer do
    subscription.events:close()
    control.notify(worker.coordinator, worker.worker_id, messages.ControlAction.unsubscribe(subscription.key))
  end
  ctx:set("Content-Type", "text/event-stream")
  ctx:set("Cache-Control", "no-cache")
  ctx:set("X-Accel-Buffering", "no")
  ctx:write_chunk("event: connected\ndata: " .. wire.encode({["clientId"] = subscription.client_id}) .. "\n\n")
  local reading: async.Task<|string?, value|>? = nil
  defer if reading then tasks.drain(reading) end
  while true do
    if not reading then reading = async.run<|string?, value|>(subscription:next) end
    local keepalive = async.run<|nil, value|>(wait_keepalive)
    defer tasks.drain(keepalive)
    case async.race_two(reading, keepalive)
    when first(status) then
      case status
      when succeeded(text) then
        if not text then return end
        local envelope = wire.object(text)
        local data: {string: value} = envelope
        if envelope["data"] is {string: value} then data = envelope["data"] end
        ctx:write_chunk("event: " .. sse_name(channel, data) .. "\ndata: " .. wire.encode(data) .. "\n\n")
        reading = nil
      else return
      end
    when second() then ctx:write_chunk(": keepalive\n\n")
    end
  end
end

--- Server-sent events for one world event channel.
function stream(channel: string): mk.Handler
  return function (ctx: mk.Context) serve_stream(ctx, channel) end
end

local function single_header(ctx: mk.Context, name: string, required: boolean): string
  local values = ctx:get_headers(name)
  if #values > 1 or (required and (#values ~= 1 or values[1] == "")) then
    raise "invalid session header"
  end
  return #values == 1 and values[1] or ""
end

function session_handshake(ctx: mk.Context)
  ctx:set("Cache-Control", "no-store")
  local address = single_header(ctx, "x-foundry-url", true)
  local user = single_header(ctx, "x-username", true)
  local world = single_header(ctx, "x-world-name", false)
  write_reply(ctx, ask(messages.ControlAction.session_handshake(address, user, world)))
end

function session_start(ctx: mk.Context)
  ctx:set("Cache-Control", "no-store")
  local worker = current()
  local source = ctx:body()
  if source == "" then
    source = "{}"
  else
    if not ctx:is_json() then raise "request body must use application/json" end
    wire.object(source)
  end
  local key = store.secure_token(16)
  defer control.notify(worker.coordinator, worker.worker_id, messages.ControlAction.session_discard(key))
  case ask(messages.ControlAction.session_start(key, source))
  when response(status, reply_body) then
    json_response(ctx, status, reply_body)
    if status == 200 then
      -- The client owns the session only once this response is on the wire.
      ctx:commit()
      case ask(messages.ControlAction.session_publish(key))
      when ack() then
      else ctx:abort()
      end
    end
  else error_response(ctx, 500, "unexpected coordinator reply")
  end
end

function session_end(ctx: mk.Context)
  ctx:set("Cache-Control", "no-store")
  local id = ctx:query("sessionId", "")
  if id == "" then id = wire.text(json_body(ctx), "sessionId") end
  write_reply(ctx, ask(messages.ControlAction.session_end(id)))
end

function session_list(ctx: mk.Context)
  ctx:set("Cache-Control", "no-store")
  write_reply(ctx, ask(session_list_action))
end

local function forward_endpoint(ctx: mk.Context, key: string)
  local worker = current()
  local endpoint = api.endpoint_for(key) as api.Endpoint
  local data: {string: value} = {}
  local content_type = ctx:get("Content-Type", "application/octet-stream")
  if endpoint:is_upload() and not ctx:is_json() then
    -- Binary upload metadata comes from the declared query parameters.
    data["fileData"] = "data:" .. content_type .. ";base64," .. api.encode_base64(ctx:body())
  else
    data = json_body(ctx)
  end
  local query = ctx:queries()
  local payload = api.build_payload(endpoint, ctx:params(), query, data)
  local client_id? = query["clientId"]
  if not client_id and data["clientId"] is string then client_id = data["clientId"] as string end
  local world: protocol.WorldHandle? = nil
  case ask(messages.ControlAction.select(client_id or ""))
  when selected(handle) then world = handle
  when response(status, body) then json_response(ctx, status, body); return
  else error_response(ctx, 500, "unexpected coordinator reply"); return
  end
  local timeout = worker.settings.request_timeout
  if timeout == 0 then timeout = endpoint.timeout_ms end
  local reply = worker.pool:request(world, endpoint.action, payload, timeout)
  if reply.status ~= 200 then json_response(ctx, reply.status, reply.body); return end
  local converted = api.response(endpoint, wire.object(reply.body), query["format"])
  ctx:status(converted.status):set("Content-Type", converted.content_type)
  for name, content in iteration.pairs(converted.headers) do ctx:set(name, content) end
  ctx:send(converted.body)
end

--- Forward one declared REST endpoint to the selected Foundry world.
function forward(key: string): mk.Handler
  return function (ctx: mk.Context) forward_endpoint(ctx, key) end
end
