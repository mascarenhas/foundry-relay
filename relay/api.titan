  local by_key: {string: Endpoint} = {}
  local actions: {string: boolean} = {}
  for index = 1, #entries do
    local endpoint = entries[index]
    by_key[endpoint.key] = endpoint
    actions[endpoint.action] = true
  end
  local frozen = entries as const {Endpoint}
  catalog = frozen
  endpoints_by_key = by_key
  known_actions = actions
end
