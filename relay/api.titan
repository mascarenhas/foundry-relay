-- REST declarations adapt the reference Go relay's single-user protocol.
local router = import "relay.router"
local wire = import "relay.wire"
local string = import "string"

record Param
  const name: string
  const kind: string
  const sources: string
  const required: boolean
end

record Endpoint
  const key: string
  const method: string
  const path: string
  const action: string
  const params: {Param}
  const timeout_ms: integer
  const special: string
end

record Reply
  const status: integer
  const body: string
  const content_type: string
  const headers: {string: string}
end

local const catalog: {Endpoint}?

function definitions(): {Endpoint}
  local snapshot: {Endpoint} = {}
  for index = 1, #catalog do snapshot[index] = catalog[index] end
  return snapshot
end

function routes(): {router.Route}
  local result: {router.Route} = {}
  for index = 1, #catalog do
    local endpoint = catalog[index]
    result[index] = router.Route(endpoint.method, endpoint.path, endpoint.key)
  end
  return result
end

function endpoint_for(key: string): Endpoint?
  for index = 1, #catalog do
    local endpoint = catalog[index]
    if endpoint.key == key then return endpoint end
  end
  return nil
end

local function Param:read(match: router.Match, body: {string: value}): (value, boolean)
  for source in string.split(self.sources) do
    if source == "b" then
      local candidate? = body[self.name]
      if candidate ~= nil then return candidate, false end
    elseif source == "q" then
      local candidate? = match.query[self.name]
      if candidate ~= nil and candidate ~= "" then return candidate, true end
    elseif source == "p" then
      local candidate? = match.params[self.name]
      if candidate ~= nil then return candidate, false end
    end
  end
  return nil, false
end

local function Param:coerce(candidate: value, from_query: boolean): value
  if self.kind == "value" then return candidate end
  if self.kind == "string" then
    if candidate is string then return candidate end
  elseif self.kind == "boolean" then
    -- `value is boolean` asks about truthiness conversion, not the JSON tag.
    if candidate == true or candidate == false then return candidate end
    if candidate is string then
      local text: string = candidate
      text = string.lower(text)
      if text == "true" then return true end
      if text == "false" then return false end
    end
  elseif self.kind == "number" then
    local number = candidate
    if candidate is string then number = wire.decode(candidate) end
    if number is float then return number end
  elseif self.kind == "array" then
    local array = candidate
    if candidate is string then array = wire.decode(candidate) end
    if array is {value} then return array end
  elseif self.kind == "object" then
    local object = candidate
    if from_query and candidate is string then object = wire.decode(candidate) end
    if object is {string: value} then return object end
  end
  raise "'" .. self.name .. "' must be a valid " .. self.kind
catch
  -- Syntax errors from query JSON become ordinary parameter errors.
  raise "'" .. self.name .. "' must be a valid " .. self.kind
end

local function any_present(payload: {string: value}, names: {string}): boolean
  for index = 1, #names do
    if payload[names[index]] ~= nil then return true end
  end
  return false
end

local function require_any(payload: {string: value}, names: {string}, message: string)
  if not any_present(payload, names) then raise message end
end

local function validate(endpoint: Endpoint, payload: {string: value})
  local action = endpoint.action
  if action == "search" then
    require_any(payload, {"query", "filter"}, "'query' or 'filter' is required")
  elseif action == "select" then
    require_any(payload, {"uuids", "name", "data", "all"},
      "At least one of 'uuids', 'name', 'data', or 'all' is required")
  elseif action == "get-user" or action == "update-user" or action == "delete-user" then
    require_any(payload, {"id", "name"}, "At least one of 'id' or 'name' is required")
  elseif action == "get-scene" then
    require_any(payload, {"sceneId", "name", "active", "viewed", "all"},
      "At least one of 'sceneId', 'name', 'active', 'viewed', or 'all' is required")
  elseif action == "update-scene" then
    require_any(payload, {"sceneId", "name", "active"},
      "At least one of 'sceneId', 'name', or 'active' is required")
  elseif action == "delete-scene" or action == "switch-scene" then
    require_any(payload, {"sceneId", "name"}, "At least one of 'sceneId' or 'name' is required")
  elseif action == "sheet-screenshot" then
    require_any(payload, {"uuid", "selected"}, "Either 'uuid' or 'selected' is required")
  elseif action == "upload-file" then
    if wire.text(payload, "path") == "" or wire.text(payload, "filename") == "" then
      raise "'path' and 'filename' are required"
    end
    local file_data = wire.text(payload, "fileData")
    if string.sub(file_data, 1, 5) ~= "data:" or not string.find(file_data, ";base64,") then
      raise "'fileData' must be a base64 data URL"
    end
  end
end

function build_payload(endpoint: Endpoint, match: router.Match,
                       body: {string: value}): {string: value}
  local result: {string: value} = {}
  for index = 1, #endpoint.params do
    local param = endpoint.params[index]
    local candidate, from_query = param:read(match, body)
    if candidate == nil then
      if param.required then raise "'" .. param.name .. "' is required" end
    elseif param.name ~= "clientId" then
      result[param.name] = param:coerce(candidate, from_query)
    end
  end
  validate(endpoint, result)
  if endpoint.special == "canvas" then
    local classes: {string: string} = {
      ["tokens"] = "Token", ["tiles"] = "Tile", ["drawings"] = "Drawing",
      ["lights"] = "AmbientLight", ["sounds"] = "AmbientSound", ["notes"] = "Note",
      ["templates"] = "MeasuredTemplate", ["walls"] = "Wall", ["regions"] = "Region",
    }
    local document_type = wire.text(result, "documentType")
    local class_name? = classes[document_type]
    if not class_name then raise "Invalid documentType" end
    result["className"] = class_name
  elseif endpoint.special == "image" then
    if result["format"] == nil then result["format"] = "png" end
    if result["quality"] == nil then result["quality"] = 0.9 end
    if endpoint.action == "sheet-screenshot" and result["scale"] == nil then
      result["scale"] = 1.0
    end
  elseif endpoint.special == "upload" then
    if result["source"] == nil then result["source"] = "data" end
  end
  if result["data"] == nil then
    local data: {string: value} = {}
    result["data"] = data
  end
  return result
end

local const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function encode_base64(source: string): string
  local output = string.writer()
  local index = 1
  while index <= #source do
    local first: integer = string.byte(source, index)
    local second = 0
    local third = 0
    if index + 1 <= #source then second = string.byte(source, index + 1) end
    if index + 2 <= #source then third = string.byte(source, index + 2) end
    output:write(string.sub(alphabet, first // 4 + 1, first // 4 + 1))
    local digit = (first % 4) * 16 + second // 16
    output:write(string.sub(alphabet, digit + 1, digit + 1))
    if index + 1 <= #source then
      digit = (second % 16) * 4 + third // 64
      output:write(string.sub(alphabet, digit + 1, digit + 1))
    else
      output:write("=")
    end
    if index + 2 <= #source then
      digit = third % 64
      output:write(string.sub(alphabet, digit + 1, digit + 1))
    else
      output:write("=")
    end
    index = index + 3
  end
  return output:drain()
end

local function base64_digit(source: string, index: integer): integer
  local byte: integer = string.byte(source, index)
  if byte >= 65 and byte <= 90 then return byte - 65 end
  if byte >= 97 and byte <= 122 then return byte - 71 end
  if byte >= 48 and byte <= 57 then return byte + 4 end
  if byte == 43 then return 62 end
  if byte == 47 then return 63 end
  raise "invalid base64 character"
end

function decode_base64(source: string): string
  local contents = source
  if string.sub(contents, 1, 5) == "data:" then
    local marker? = string.find(contents, ";base64,")
    if not marker then raise "invalid base64 data URL" end
    contents = string.sub(contents, marker + 8)
  end
  if #contents % 4 ~= 0 then raise "invalid base64 length" end
  local output = string.writer()
  local index = 1
  while index <= #contents do
    local a = base64_digit(contents, index)
    local b = base64_digit(contents, index + 1)
    local c = string.sub(contents, index + 2, index + 2)
    local d = string.sub(contents, index + 3, index + 3)
    output:write(string.char(a * 4 + b // 16))
    if c == "=" then
      if d ~= "=" or index + 3 ~= #contents or b % 16 ~= 0 then
        raise "invalid base64 padding"
      end
    else
      local third = base64_digit(contents, index + 2)
      output:write(string.char((b % 16) * 16 + third // 4))
      if d == "=" then
        if index + 3 ~= #contents or third % 4 ~= 0 then raise "invalid base64 padding" end
      else
        local fourth = base64_digit(contents, index + 3)
        output:write(string.char((third % 4) * 64 + fourth))
      end
    end
    index = index + 4
  end
  return output:drain()
end

local function safe_header(source: string, fallback: string): string
  if source == "" or string.match(source, "[^ -~]") then return fallback end
  return source
end

local function quoted_filename(source: string): string
  return string.gsub(source, [=[[^ -~]|["\\]]=], function (_match) return "_" end)
end

function response(endpoint: Endpoint, result: {string: value}, format: string?): Reply
  local status = 200
  if result["error"] ~= nil then status = 400 end
  local headers: {string: string} = {}
  if status == 400 then return Reply(status, wire.encode(result), "application/json", headers) end
  local encoded = ""
  local content_type = "application/octet-stream"
  if endpoint.special == "download" and format ~= "base64" then
    encoded = wire.text(result, "fileData")
    content_type = safe_header(wire.text(result, "mimeType"), content_type)
    local filename = wire.text(result, "fileName", wire.text(result, "filename", "file"))
    headers["Content-Disposition"] = "attachment; filename=\"" .. quoted_filename(filename) .. "\""
  elseif endpoint.special == "image" and format ~= "base64" then
    encoded = wire.text(result, "imageData")
    local nested = result["data"]
    if encoded == "" and nested is {string: value} then
      local data: {string: value} = nested
      encoded = wire.text(data, "imageData")
    end
    content_type = safe_header(wire.text(result, "mimeType"), "image/png")
    local width = result["width"]
    local height = result["height"]
    if width is float then headers["X-Image-Width"] = string.tostring(width) end
    if height is float then headers["X-Image-Height"] = string.tostring(height) end
  end
  if encoded ~= "" then
    local binary = decode_base64(encoded)
    return Reply(status, binary, content_type, headers)
  end
  return Reply(status, wire.encode(result), "application/json", {})
end

