-- REST declarations adapt the reference Go relay's single-user protocol.
local wire = import "relay.wire"
local string = import "string"

union ParamKind
  is_string()
  is_boolean()
  is_number()
  is_array()
  is_object()
  is_value()
end

union ParamSource
  query()
  body()
  path()
  query_then_body()
  body_then_query()
end

union EndpointKind
  standard()
  canvas()
  image()
  download()
  upload()
end

local const KIND_STRING = ParamKind.is_string()
local const KIND_BOOLEAN = ParamKind.is_boolean()
local const KIND_NUMBER = ParamKind.is_number()
local const KIND_ARRAY = ParamKind.is_array()
local const KIND_OBJECT = ParamKind.is_object()
local const KIND_VALUE = ParamKind.is_value()

local const SRC_Q = ParamSource.query()
local const SRC_B = ParamSource.body()
local const SRC_P = ParamSource.path()
local const SRC_QB = ParamSource.query_then_body()
local const SRC_BQ = ParamSource.body_then_query()

local const EP_STANDARD = EndpointKind.standard()
local const EP_CANVAS = EndpointKind.canvas()
local const EP_IMAGE = EndpointKind.image()
local const EP_DOWNLOAD = EndpointKind.download()
local const EP_UPLOAD = EndpointKind.upload()

record Param
  const name: string
  const kind: ParamKind
  const sources: ParamSource
  const required: boolean
end

record Endpoint
  const key: string
  const method: string
  const path: string
  const action: string
  const params: const {Param}
  const timeout_ms: integer
  const special: EndpointKind
end

record Reply
  const status: integer
  const body: string
  const content_type: string
  const headers: {string: string}
end

local const catalog: (const {Endpoint})?
local const endpoints_by_key: {string: Endpoint}?
local const known_actions: {string: boolean}?

function definitions(): const {Endpoint}
  return catalog
end

function endpoint_for(key: string): Endpoint?
  return endpoints_by_key[key]
end

function Endpoint:is_upload(): boolean
  case self.special
  when upload() then return true
  else return false
  end
end

function is_known_action(action: string): boolean
  return known_actions[action] == true
end

function ParamKind:label(): string
  case self
  when is_string() then return "string"
  when is_boolean() then return "boolean"
  when is_number() then return "number"
  when is_array() then return "array"
  when is_object() then return "object"
  when is_value() then return "value"
  end
end

-- Path parameters, decoded first-value query fields, and the JSON body.
local function Param:read(params: {string: string}, query: {string: string},
                          body: {string: value}): (value, boolean)
  case self.sources
  when body() then
    local candidate? = body[self.name]
    if candidate ~= nil then return candidate, false end
  when query() then
    local candidate? = query[self.name]
    if candidate ~= nil and candidate ~= "" then return candidate, true end
  when path() then
    local candidate? = params[self.name]
    if candidate ~= nil then return candidate, false end
  when query_then_body() then
    local query_candidate? = query[self.name]
    if query_candidate ~= nil and query_candidate ~= "" then return query_candidate, true end
    local body_candidate? = body[self.name]
    if body_candidate ~= nil then return body_candidate, false end
  when body_then_query() then
    local body_candidate? = body[self.name]
    if body_candidate ~= nil then return body_candidate, false end
    local query_candidate? = query[self.name]
    if query_candidate ~= nil and query_candidate ~= "" then return query_candidate, true end
  end
  return nil, false
end

local function Param:coerce(candidate: value, from_query: boolean): value
  case self.kind
  when is_value() then
    return candidate
  when is_string() then
    if candidate is string then return candidate end
  when is_boolean() then
    -- `value is boolean` asks about truthiness conversion, not the JSON tag.
    if candidate == true or candidate == false then return candidate end
    if candidate is string then
      local text: string = candidate
      text = string.lower(text)
      if text == "true" then return true end
      if text == "false" then return false end
    end
  when is_number() then
    local number = candidate
    if candidate is string then number = wire.decode(candidate) end
    if number is float then return number end
  when is_array() then
    local array = candidate
    if candidate is string then array = wire.decode(candidate) end
    if array is {value} then return array end
  when is_object() then
    local object = candidate
    if from_query and candidate is string then object = wire.decode(candidate) end
    if object is {string: value} then return object end
  end
  raise "'" .. self.name .. "' must be a valid " .. self.kind:label()
catch
  -- Syntax errors from query JSON become ordinary parameter errors.
  raise "'" .. self.name .. "' must be a valid " .. self.kind:label()
end

local const keys_search: const {string} = {"query", "filter"}
local const keys_select: const {string} = {"uuids", "name", "data", "all"}
local const keys_user: const {string} = {"id", "name"}
local const keys_get_scene: const {string} = {"sceneId", "name", "active", "viewed", "all"}
local const keys_update_scene: const {string} = {"sceneId", "name", "active"}
local const keys_scene_id_or_name: const {string} = {"sceneId", "name"}
local const keys_sheet_screenshot: const {string} = {"uuid", "selected"}

local const canvas_classes: {string: string} = {
  ["tokens"] = "Token", ["tiles"] = "Tile", ["drawings"] = "Drawing",
  ["lights"] = "AmbientLight", ["sounds"] = "AmbientSound", ["notes"] = "Note",
  ["templates"] = "MeasuredTemplate", ["walls"] = "Wall", ["regions"] = "Region",
}

local function any_present(payload: {string: value}, names: const {string}): boolean
  for index = 1, #names do
    if payload[names[index]] ~= nil then return true end
  end
  return false
end

local function require_any(payload: {string: value}, names: const {string}, message: string)
  if not any_present(payload, names) then raise message end
end

local function Endpoint:validate(payload: {string: value})
  local action = self.action
  if action == "search" then
    require_any(payload, keys_search, "'query' or 'filter' is required")
  elseif action == "select" then
    require_any(payload, keys_select,
      "At least one of 'uuids', 'name', 'data', or 'all' is required")
  elseif action == "get-user" or action == "update-user" or action == "delete-user" then
    require_any(payload, keys_user, "At least one of 'id' or 'name' is required")
  elseif action == "get-scene" then
    require_any(payload, keys_get_scene,
      "At least one of 'sceneId', 'name', 'active', 'viewed', or 'all' is required")
  elseif action == "update-scene" then
    require_any(payload, keys_update_scene,
      "At least one of 'sceneId', 'name', or 'active' is required")
  elseif action == "delete-scene" or action == "switch-scene" then
    require_any(payload, keys_scene_id_or_name, "At least one of 'sceneId' or 'name' is required")
  elseif action == "sheet-screenshot" then
    require_any(payload, keys_sheet_screenshot, "Either 'uuid' or 'selected' is required")
  elseif action == "upload-file" then
    if wire.text(payload, "path") == "" or wire.text(payload, "filename") == "" then
      raise "'path' and 'filename' are required"
    end
    local file_data = wire.text(payload, "fileData")
    if string.sub(file_data, 1, 5) ~= "data:" or not string.find(file_data, ";base64,") then
      raise "'fileData' must be a base64 data URL"
    end
  end
end

function build_payload(endpoint: Endpoint, params: {string: string}, query: {string: string},
                       body: {string: value}): {string: value}
  local result: {string: value} = {}
  for index = 1, #endpoint.params do
    local param = endpoint.params[index]
    local candidate, from_query = param:read(params, query, body)
    if candidate == nil then
      if param.required then raise "'" .. param.name .. "' is required" end
    elseif param.name ~= "clientId" then
      result[param.name] = param:coerce(candidate, from_query)
    end
  end
  endpoint:validate(result)
  case endpoint.special
  when canvas() then
    local document_type = wire.text(result, "documentType")
    local class_name? = canvas_classes[document_type]
    if not class_name then raise "Invalid documentType" end
    result["className"] = class_name
  when image() then
    if result["format"] == nil then result["format"] = "png" end
    if result["quality"] == nil then result["quality"] = 0.9 end
    if endpoint.action == "sheet-screenshot" and result["scale"] == nil then
      result["scale"] = 1.0
    end
  when upload() then
    if result["source"] == nil then result["source"] = "data" end
  else
  end
  if result["data"] == nil then
    local data: {string: value} = {}
    result["data"] = data
  end
  return result
end

local const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local const eq_byte = 61

function encode_base64(source: string): string
  local output = string.writer()
  local index = 1
  local length = #source
  while index <= length do
    local first: integer = string.byte(source, index)
    local has_second = index + 1 <= length
    local has_third = index + 2 <= length
    local second = 0
    if has_second then second = string.byte(source, index + 1) end
    local third = 0
    if has_third then third = string.byte(source, index + 2) end
    local c1: integer = string.byte(alphabet, first // 4 + 1)
    local c2: integer = string.byte(alphabet, (first % 4) * 16 + second // 16 + 1)
    local c3 = eq_byte
    if has_second then
      c3 = string.byte(alphabet, (second % 16) * 4 + third // 64 + 1)
    end
    local c4 = eq_byte
    if has_third then
      c4 = string.byte(alphabet, third % 64 + 1)
    end
    output:write(string.char(c1, c2, c3, c4))
    index = index + 3
  end
  return output:drain()
end

local function base64_digit(source: string, index: integer): integer
  local byte: integer = string.byte(source, index)
  if byte >= 65 and byte <= 90 then return byte - 65 end
  if byte >= 97 and byte <= 122 then return byte - 71 end
  if byte >= 48 and byte <= 57 then return byte + 4 end
  if byte == 43 then return 62 end
  if byte == 47 then return 63 end
  raise "invalid base64 character"
end

function decode_base64(source: string): string
  local contents = source
  if string.sub(contents, 1, 5) == "data:" then
    local marker? = string.find(contents, ";base64,")
    if not marker then raise "invalid base64 data URL" end
    contents = string.sub(contents, marker + 8)
  end
  local length = #contents
  if length % 4 ~= 0 then raise "invalid base64 length" end
  local output = string.writer()
  local index = 1
  while index <= length do
    local a = base64_digit(contents, index)
    local b = base64_digit(contents, index + 1)
    local c_byte: integer = string.byte(contents, index + 2)
    local d_byte: integer = string.byte(contents, index + 3)
    local o1 = a * 4 + b // 16
    if c_byte == eq_byte then
      if d_byte ~= eq_byte or index + 3 ~= length or b % 16 ~= 0 then
        raise "invalid base64 padding"
      end
      output:write(string.char(o1))
    else
      local third = base64_digit(contents, index + 2)
      local o2 = (b % 16) * 16 + third // 4
      if d_byte == eq_byte then
        if index + 3 ~= length or third % 4 ~= 0 then raise "invalid base64 padding" end
        output:write(string.char(o1, o2))
      else
        local fourth = base64_digit(contents, index + 3)
        local o3 = (third % 4) * 64 + fourth
        output:write(string.char(o1, o2, o3))
      end
    end
    index = index + 4
  end
  return output:drain()
end

local const unsafe_filename_re = string.compile_regex([=[[^ -~]|["\\]]=])

local function underscore(_: string): string
  return "_"
end

local function safe_header(source: string, fallback: string): string
  if source == "" then return fallback end
  for index = 1, #source do
    local byte: integer = string.byte(source, index)
    if byte < 32 or byte > 126 then return fallback end
  end
  return source
end

local function quoted_filename(source: string): string
  local cleaned = unsafe_filename_re:gsub(source, underscore)
  return cleaned
end

function response(endpoint: Endpoint, result: {string: value}, format: string?): Reply
  local status = 200
  if result["error"] ~= nil then status = 400 end
  local headers: {string: string} = {}
  if status == 400 then return Reply(status, wire.encode(result), "application/json", headers) end
  local encoded = ""
  local content_type = "application/octet-stream"
  if format ~= "base64" then
    case endpoint.special
    when download() then
      encoded = wire.text(result, "fileData")
      content_type = safe_header(wire.text(result, "mimeType"), content_type)
      local filename = wire.text(result, "fileName", wire.text(result, "filename", "file"))
      headers["Content-Disposition"] = "attachment; filename=\"" .. quoted_filename(filename) .. "\""
    when image() then
      encoded = wire.text(result, "imageData")
      local nested = result["data"]
      if encoded == "" and nested is {string: value} then
        local data: {string: value} = nested
        encoded = wire.text(data, "imageData")
      end
      content_type = safe_header(wire.text(result, "mimeType"), "image/png")
      local width = result["width"]
      local height = result["height"]
      if width is float then headers["X-Image-Width"] = string.tostring(width) end
      if height is float then headers["X-Image-Height"] = string.tostring(height) end
    else
    end
  end
  if encoded ~= "" then
    local binary = decode_base64(encoded)
    return Reply(status, binary, content_type, headers)
  end
  return Reply(status, wire.encode(result), "application/json", {})
end

