-- Declarative routes are checked at construction, and matched in declaration order.
local string = import "string"
local http = import "http"
local json = import "json"
local peg = import "peg"
local iteration = import "iteration"

local const max_target_bytes = 16384
local const max_query_fields = 256
local const max_route_bytes = 1024
local const max_route_parts = 64

-- The declaration parser produces a typed intermediate form before compilation.
union RoutePart
  literal(text: string, position: integer)
  parameter(name: string, position: integer)
  wildcard(position: integer)
end

record RouteError
  const code: string
  const message: string
  const position: integer
  const line: integer
  const column: integer
end

local const route_grammar: peg.Pattern?
local const route_messages: {string: string} = {
  ["expected_slash"] = "route pattern must begin with /",
  ["expected_parameter_name"] = "route parameter needs an ASCII identifier",
  ["parameter_tail"] = "route parameter must occupy a whole segment",
  ["wildcard_not_terminal"] = "route wildcard must be the final segment",
  ["partial_wildcard"] = "route wildcard must occupy a whole segment",
  ["query_or_fragment"] = "route pattern cannot contain a query or fragment",
  ["percent_escape"] = "route literal contains an invalid percent escape",
  ["nul_escape"] = "route literal cannot contain an encoded NUL",
  ["control_character"] = "route pattern cannot contain control characters",
  ["duplicate_parameter"] = "route parameter names must be unique",
  ["route_limit"] = "route pattern exceeds its size or part limit",
  ["invalid_declaration"] = "route method and action must be nonempty",
  ["trailing_input"] = "unexpected byte in route pattern",
}

record Target
  const path: string
  const segments: {string}
  const query: {string: string}
  const query_values: {string: {string}}
end

record Route
  const method: string
  const pattern: string
  const action: string
  local const parts: {RoutePart}
  local const matcher: peg.Pattern
end

record Match
  const route: Route
  const action: string
  const params: {string: string}
  const query: {string: string}
  const query_values: {string: {string}}
end

record Resolution
  const status: integer
  const match: Match?
  const allowed: {string}
  const error: string?
end

record Router
  local const routes: {Route}
end

local function hex_digit(byte: integer): integer?
  if byte >= 48 and byte <= 57 then return byte - 48 end
  if byte >= 65 and byte <= 70 then return byte - 55 end
  if byte >= 97 and byte <= 102 then return byte - 87 end
  return nil
end

-- Decode each path segment independently: an encoded slash stays within its segment.
function percent_decode(subject: string, plus_as_space: boolean?): string
  local result = string.writer()
  local index = 1
  while index <= #subject do
    local byte: integer = string.byte(subject, index)
    if byte == 37 then
      if index + 2 > #subject then raise "incomplete percent escape" end
      local high? = hex_digit(string.byte(subject, index + 1))
      local low? = hex_digit(string.byte(subject, index + 2))
      if high == nil or low == nil then raise "invalid percent escape" end
      local decoded = high * 16 + low
      if decoded == 0 then raise "NUL is not allowed in a request target" end
      result:write(string.char(decoded))
      index = index + 3
    elseif plus_as_space and byte == 43 then
      result:write(" ")
      index = index + 1
    else
      if byte == 0 or byte < 32 or byte == 127 then
        raise "control character in request target"
      end
      result:write(string.char(byte))
      index = index + 1
    end
  end
  return result:drain()
end

-- Query maps expose the first value; query_values retains all occurrences in wire order.
function parse_target(target: string): Target
  if #target > max_target_bytes then raise "request target is too long" end
  if string.sub(target, 1, 1) ~= "/" then raise "request target must begin with /" end
  if string.find(target, "#") then raise "request target cannot contain a fragment" end
  local separator? = string.find(target, "?")
  local path = target
  local query_source = ""
  if separator then
    path = string.sub(target, 1, separator - 1)
    query_source = string.sub(target, separator + 1)
  end
  local segments: {string} = {}
  if path ~= "/" then
    for segment in string.split(string.sub(path, 2), "/") do
      segments[#segments + 1] = percent_decode(segment)
    end
  end
  local query: {string: string} = {}
  local query_values: {string: {string}} = {}
  if query_source ~= "" then
    local fields: {string} = {}
    for field in string.split(query_source, "&") do fields[#fields + 1] = field end
    if #fields > max_query_fields then raise "too many query parameters" end
    for index = 1, #fields do
      local field = fields[index]
      if field ~= "" then
        local equals? = string.find(field, "=")
        local key = field
        local contents = ""
        if equals then
          key = string.sub(field, 1, equals - 1)
          contents = string.sub(field, equals + 1)
        end
        key = percent_decode(key, true)
        contents = percent_decode(contents, true)
        local values? = query_values[key]
        if values == nil then
          query[key] = contents
          query_values[key] = {contents}
        else
          values[#values + 1] = contents
        end
      end
    end
  end
  return Target(path, segments, query, query_values)
end

local function route_error(pattern: string, code: string, position: integer): RouteError
  local line, column = peg.line_column(pattern, position)
  return RouteError(code, route_messages[code] or "invalid route pattern", position, line, column)
end

local function literal_part(position: value, text: value): RoutePart
  return RoutePart.literal(text, position)
end

local function parameter_part(position: value, name: value): RoutePart
  return RoutePart.parameter(name, position)
end

local function wildcard_part(position: value): RoutePart
  return RoutePart.wildcard(position)
end

-- A declaration mismatch is data; Route.new raises this same diagnostic record.
function parse_route(pattern: string): ({RoutePart}?, RouteError?)
  if #pattern > max_route_bytes then return nil, route_error(pattern, "route_limit", max_route_bytes + 1) end
  local captured, label, position = route_grammar:match(pattern)
  if captured == nil then
    local code: string = label
    local at: integer = position
    return nil, route_error(pattern, code, at)
  end
  local raw: {integer: RoutePart} = captured
  local parts: {RoutePart} = {}
  local names: {string: boolean} = {}
  for index = 1, #raw do
    local part = raw[index]
    local name: string? = nil
    local at = 1
    case part
    when literal(_, position) then at = position
    when parameter(parameter, position) then name = parameter; at = position
    when wildcard(position) then name = "wildcard"; at = position
    end
    if index > max_route_parts then return nil, route_error(pattern, "route_limit", at) end
    if name then
      if names[name] then return nil, route_error(pattern, "duplicate_parameter", at) end
      names[name] = true
    end
    parts[index] = part
  end
  return parts, nil
end

local const hex_alphabet = "0123456789ABCDEF"

-- Match a literal byte or its URI escape. Encoded / and % remain inside a segment.
local function literal_matcher(text: string): peg.Pattern
  local decoded = percent_decode(text)
  local result = peg.succeed()
  for index = 1, #decoded do
    local byte: integer = string.byte(decoded, index)
    local high = string.sub(hex_alphabet, byte // 16 + 1, byte // 16 + 1)
    local low = string.sub(hex_alphabet, byte % 16 + 1, byte % 16 + 1)
    local escaped = peg.sequence(peg.literal("%"), peg.set(high .. string.lower(high)),
      peg.set(low .. string.lower(low)))
    local unit = escaped
    if byte ~= 47 and byte ~= 37 then unit = peg.choice(peg.literal(string.char(byte)), escaped) end
    result = peg.sequence(result, unit)
  end
  return result
end

local function compile_route(parts: {RoutePart}): peg.Pattern
  local result = peg.literal("/")
  local segment = peg.one_or_more(peg.difference(peg.any(), peg.literal("/")))
  for index = 1, #parts do
    local part = parts[index]
    case part
    when literal(text) then
      if index > 1 then result = peg.sequence(result, peg.literal("/")) end
      result = peg.sequence(result, literal_matcher(text))
    when parameter(name) then
      if index > 1 then result = peg.sequence(result, peg.literal("/")) end
      result = peg.sequence(result, peg.group(peg.capture(segment), name))
    when wildcard() then
      local remaining = peg.capture(peg.zero_or_more(peg.any()))
      if index > 1 then
        remaining = peg.choice(peg.sequence(peg.literal("/"), remaining), peg.capture(peg.literal("")))
      end
      result = peg.sequence(result, peg.group(remaining, "wildcard"))
    end
  end
  return peg.table_capture(peg.sequence(result, peg.negative(peg.any())))
end

function Route.new(method: string, pattern: string, action: string): Route
  if method == "" or action == "" then raise route_error(pattern, "invalid_declaration", 1) end
  local parts?, problem? = parse_route(pattern)
  if problem then raise problem end
  return {method = method, pattern = pattern, action = action, parts = parts,
    matcher = compile_route(parts)}
end

function Router.new(routes: {Route}): Router
  local snapshot: {Route} = {}
  for index = 1, #routes do snapshot[index] = routes[index] end
  return {routes = snapshot}
end

local function Route:parameters(path: string): ({string: string})?
  local captured = self.matcher:match(path)
  if captured == nil then return nil end
  local params: {string: string} = captured
  for name, raw in iteration.pairs(params) do params[name] = percent_decode(raw) end
  return params
end

function Router:match(method: string, target: string): Resolution
  local parsed = parse_target(target)
  local allowed: {string} = {}
  local seen: {string: boolean} = {}
  for index = 1, #self.routes do
    local route = self.routes[index]
    local params? = route:parameters(parsed.path)
    if params then
      if route.method == method or route.method == "*" then
        local found = Match(route, route.action, params, parsed.query, parsed.query_values)
        return Resolution(200, found, {}, nil)
      end
      if not seen[route.method] then
        seen[route.method] = true
        allowed[#allowed + 1] = route.method
      end
    end
  end
  if #allowed > 0 then return Resolution(405, nil, allowed, nil) end
  return Resolution(404, nil, {}, nil)
catch
  if error is string then return Resolution(400, nil, {}, error) end
  raise
end

function json_response(response: http.Response, status: integer, body: string)
  response:set_status(status)
  response:set_header("Content-Type", "application/json; charset=utf-8")
  response:set_header("Content-Length", "" .. #body)
  response:write(body)
end

function error_body(message: string): string
  local body: {string: value} = {["error"] = message}
  return json.encode(body)
end

function error_response(response: http.Response, status: integer, message: string)
  json_response(response, status, error_body(message))
end

function allow_header(methods: {string}): string
  local result = string.writer()
  for index = 1, #methods do
    if index > 1 then result:write(", ") end
    result:write(methods[index])
  end
  return result:drain()
end

do
  route_grammar = peg.compile([[
    Route <- {|
      ('/' / %{expected_slash})
      (!. / (Part ('/' Part)*))
      (!. / Invalid)
    |}
    Part <- Parameter / Wildcard / Literal
    Parameter <- ({} ':' {Name / %{expected_parameter_name}}
      (&'/' / !. / %{parameter_tail})) -> parameter_part
    Name <- [A-Za-z_] [A-Za-z0-9_]*
    Wildcard <- ({} '*' (!. / %{wildcard_not_terminal})) -> wildcard_part
    Literal <- ({} {LiteralByte*}) -> literal_part
    LiteralByte <- '%' (&'00' %{nul_escape} /
      ([0-9A-Fa-f] / %{percent_escape}) ([0-9A-Fa-f] / %{percent_escape})) /
      (!('/' / '*' / '?' / '#' / '%' / %control) .)
    Invalid <- (&('?' / '#') %{query_or_fragment}) /
      (&'*' %{partial_wildcard}) / (&%control %{control_character}) / %{trailing_input}
  ]], {
    peg.define_value("parameter_part", parameter_part),
    peg.define_value("literal_part", literal_part),
    peg.define_value("wildcard_part", wildcard_part),
    peg.define("control", peg.choice(peg.ranges("\0\31"), peg.literal("\127"))),
  })
end
