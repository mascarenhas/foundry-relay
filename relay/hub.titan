-- Main-state live directory and persistent SSE registry. Transports live in world.
local async = import "async"
local timer = import "timer"
local thread = import "thread"
local uv = import "uv"
local iteration = import "iteration"
local wire = import "relay.wire"
local store = import "relay.store"
local log = import "relay.log"
local protocol = import "relay.world_protocol"
local tasks = import "relay.tasks"
local replies = import "relay.replies"

record Reply
  const status: integer
  const body: string
end

local record Waiter
  const task: async.Task
  const token: async.ResumeToken
end

local record Subscriber
  const subscription: protocol.Subscription
  const target: protocol.SubscriptionTarget
end

record Session
  const id: string
  const world: protocol.WorldHandle
  local const owner: Hub
  local closed: boolean
  local retirement: async.Task<|nil, value|>?
end

local record Selection
  const session: Session?
  const problem: string?
end

local record Publication
  const session: Session
  const activation: protocol.Activation
end

record Hub
  local const sessions: {string: Session}
  local const subscribers: {Subscriber}
  local const maximum: integer
  local const heartbeat: integer
  local closed: boolean
  local const logger: log.Logger?
  local owner: async.Task?
  local const waiters: {Waiter}
end

function Hub.new(maximum: integer, heartbeat: integer, logger: log.Logger?): Hub
  return {sessions = {}, subscribers = {}, maximum = maximum, heartbeat = heartbeat,
    closed = false, logger = logger, owner = nil, waiters = {}}
end

function drain<|A|>(task: async.Task<|A, value|>) tasks.drain(task) end

local function Hub:remove_waiter(waiter: Waiter)
  for index = 1, #self.waiters do
    if self.waiters[index] == waiter then
      for next = index + 1, #self.waiters do self.waiters[next - 1] = self.waiters[next] end
      self.waiters[#self.waiters] = nil
      return
    end
  end
end

local function Hub:release()
  if #self.waiters == 0 then self.owner = nil; return end
  local waiter = self.waiters[1]
  self:remove_waiter(waiter)
  self.owner = waiter.task
  waiter.task:resume(waiter.token)
end

local function Hub:acquire()
  async.checkpoint()
  local current = async.running()
  if not self.owner then self.owner = current; return end
  local waiter = Waiter(current, async.ResumeToken("relay security transition"))
  self.waiters[#self.waiters + 1] = waiter
  local detach = function ()
    self:remove_waiter(waiter)
    if self.owner == current then self:release() end
  end
  do async.suspend(waiter.token, detach)
  catch detach(); raise end
end

-- Reentrant only for the same Task: Manager admission calls online/select.
function Hub:transition<|T|>(operation: function (): T): T
  if self.owner == async.running() then return operation() end
  self:acquire()
  defer self:release()
  return operation()
end

local function Session:terminal(): nil
  self.world.health:receive_result()
  return nil
end

local function Session:quiesce_handshake(reason: string?)
  if self.closed or self.world.health:is_closed() then return end
  local tx, rx = thread.channel<|boolean|>(1)
  defer do rx:close(); tx:close() end
  local ack = async.run<|boolean, value|>(function (): boolean
    self.world.commands:send(protocol.WorldCommand.quiesce(reason or "disconnect", tx))
    return rx:receive()
  catch
    -- Closed/cancelled delivery cannot grant admission; health must settle it.
    return false
  end)
  local stopped = async.run<|nil, value|>(self:terminal)
  defer do tasks.drain(ack); tasks.drain(stopped) end
  case async.race_two(ack, stopped)
  when first(status) then
    case status
    when succeeded(confirmed) then if confirmed then return end
    else
    end
    -- Failed delivery is not an ACK. Only actual join makes that safe.
    tasks.await_terminal(stopped)
  when second() then
  end
end

function Session:quiesce(reason: string?)
  local handshake = async.run<|nil, value|>(function (): nil
    self:quiesce_handshake(reason)
    return nil
  end)
  tasks.await_terminal(handshake)
  case handshake:status()
  when succeeded() then
  when failed(failure) then failure:raise()
  when cancelled(reason) then raise reason
  else raise "Foundry quiescence did not finish"
  end
end

local function Session:stop(graceful: boolean): nil
  if not self.world.health:is_closed() then
    do self.world.commands:send(protocol.WorldCommand.stop(graceful)) catch end
    self:terminal()
  end
  return nil
end

function Session:close()
  if not self.retirement then
    self.retirement = async.run<|nil, value|>(function (): nil
      -- Cleanup owns the captured handle even when its caller was cancelled.
      self.owner:transition<|nil|>(function (): nil
        self:quiesce("close")
        if self.owner.sessions[self.id] == self then self.owner.sessions[self.id] = nil end
        self.closed = true
        return nil
      end)
      return self:stop(false)
    end)
  end
  tasks.await_terminal(self.retirement)
end

local function Hub:subscription_count(id: string, channel: string): integer
  local count = 0
  for index = 1, #self.subscribers do
    local entry = self.subscribers[index]
    if entry.subscription.client_id == id and entry.target.channel == channel and not entry.target.events:is_closed() then
      count = count + 1
    end
  end
  return count
end

function Hub:subscription_snapshot(id: string): protocol.Activation
  local targets: {protocol.SubscriptionTarget} = {}
  for index = 1, #self.subscribers do
    local entry = self.subscribers[index]
    if entry.subscription.client_id == id and not entry.target.events:is_closed() then targets[#targets + 1] = entry.target end
  end
  local channels: const {string} = {"chat-events", "roll-events", "hooks", "combat-events", "actor-events", "scene-events"}
  local counts: {protocol.ChannelCount} = {}
  for index = 1, #channels do counts[index] = protocol.ChannelCount(channels[index], self:subscription_count(id, channels[index])) end
  return protocol.Activation(targets, counts)
end

function Hub:publish_authenticated(world: protocol.WorldHandle): (Session, protocol.Activation)
  local published = self:transition<|Publication|>(function (): Publication
    if self.closed or world.health:is_closed() then raise "relay is closed" end
    local old? = self.sessions[world.client_id]
    if old then old:quiesce("replacement") end
    if old then
      old.closed = true
      if self.sessions[old.id] == old then self.sessions[old.id] = nil end
      old.retirement = async.run<|nil, value|>(function (): nil return old:stop(true) end)
    end
    -- Quiescence is irreversible. Complete incumbent retirement first; a
    -- cancelled admission must not publish its abandoned replacement.
    async.checkpoint()
    local session = Session(world.client_id, world, self, false, nil)
    self.sessions[world.client_id] = session
    log.emit(self.logger, "info", "websocket_connected", {["client_id"] = world.client_id})
    return Publication(session, self:subscription_snapshot(world.client_id))
  end)
  return published.session, published.activation
end

function Hub:retire(id: string, key: string)
  self:transition<|nil|>(function (): nil
    local session? = self.sessions[id]
    if session and session.world.key == key then session.closed = true; self.sessions[id] = nil end
    return nil
  end)
end

function Hub:online(id: string): boolean
  return self:transition<|boolean|>(function (): boolean
    local session? = self.sessions[id]
    return not self.closed and session ~= nil and not session.closed and not session.world.health:is_closed()
  end)
end

function Hub:online_ids(): {string}
  return self:transition<|{string}|>(function (): {string}
    local ids: {string} = {}
    if not self.closed then
      for id, session in iteration.pairs(self.sessions) do if not session.closed and not session.world.health:is_closed() then ids[#ids + 1] = id end end
    end
    return ids
  end)
end

function Hub:select(id: string?): (Session?, string?)
  local selected = self:transition<|Selection|>(function (): Selection
    if self.closed then return Selection(nil, "relay is closed") end
    if id and id ~= "" then
      local session? = self.sessions[id]
      if session and not session.closed and not session.world.health:is_closed() then return Selection(session, nil) end
      return Selection(nil, "Foundry world is offline")
    end
    local selected: Session? = nil
    for _, session in iteration.pairs(self.sessions) do
      if not session.closed and not session.world.health:is_closed() then
        if selected then return Selection(nil, "multiple worlds are online; specify clientId") end
        selected = session
      end
    end
    if not selected then return Selection(nil, "no Foundry worlds are online") end
    return Selection(selected, nil)
  end)
  return selected.session, selected.problem
end

function Session:request(action: string, payload: {string: value}, timeout: integer): Reply
  if self.closed then return Reply(503, wire.error_body("Foundry world is offline")) end
  -- Main-state headless readiness is low rate; API workers retain their pool4.
  local pool = replies.Pool(1)
  defer pool:close()
  local response = pool:request(self.world, action, payload, timeout)
  return Reply(response.status, response.body)
end

function Hub:subscribe(id: string, channel: string): protocol.Subscription
  return self:transition<|protocol.Subscription|>(function (): protocol.Subscription
    if self.closed then raise "relay is closed" end
    local tx, rx = thread.channel<|string|>(128)
    local key = store.secure_token(16)
    local subscription = protocol.Subscription(key, id, channel, rx)
    self.subscribers[#self.subscribers + 1] = Subscriber(subscription, protocol.SubscriptionTarget(key, channel, tx))
    do
      local session? = self.sessions[id]
      if session and not session.closed then session.world.commands:send(protocol.WorldCommand.subscribe(self.subscribers[#self.subscribers].target, self:subscription_count(id, channel))) end
    catch self:unsubscribe(key); raise end
    return subscription
  end)
end

function Hub:unsubscribe(key: string)
  self:transition<|nil|>(function (): nil
    for index = 1, #self.subscribers do
      local entry = self.subscribers[index]
      if entry.subscription.key == key then
        entry.target.events:close(); entry.subscription.events:close()
        for next = index + 1, #self.subscribers do self.subscribers[next - 1] = self.subscribers[next] end
        self.subscribers[#self.subscribers] = nil
        local session? = self.sessions[entry.subscription.client_id]
        if session and not session.closed then
          do session.world.commands:send(protocol.WorldCommand.unsubscribe(key, entry.target.channel, self:subscription_count(session.id, entry.target.channel))) catch end
        end
        return nil
      end
    end
    return nil
  end)
end

function Hub:disconnect(id: string): Session?
  return self:transition<|Session?|>(function (): Session?
    local session? = self.sessions[id]
    if session then
      session:quiesce("disconnect")
      session.closed = true
      self.sessions[id] = nil
      if not session.retirement then session.retirement = async.run<|nil, value|>(function (): nil return session:stop(false) end) end
    end
    return session
  end)
end

function Hub:close()
  local retiring = self:transition<|{Session}|>(function (): {Session}
    local result: {Session} = {}
    if self.closed then return result end
    self.closed = true
    for _, session in iteration.pairs(self.sessions) do session.closed = true; result[#result + 1] = session end
    for index = 1, #self.subscribers do self.subscribers[index].target.events:close() end
    return result
  end)
  for index = 1, #retiring do retiring[index]:close() end
end
