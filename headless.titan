-- Retained explicit spike harness; production sessions use the REST API.
local async = import "async"
local os = import "os"
local timer = import "timer"
local config = import "relay.config"
local server = import "relay.server"
local store = import "relay.store"
local hub = import "relay.hub"
local input = import "relay.spike_input"
local foundry = import "relay.foundry_session"

function main(args: {string}): integer
  if #args ~= 3 then
    os.stderr:write("Usage: foundry-relay-headless FIXTURE CHROME PROFILE_PARENT\n")
    return 2
  end
  local fixture = input.load(args[1])
  local settings = config.load()
  local database = store.open(settings.database)
  defer database:close()
  local client = foundry.existing_client(database:list(), fixture.world, fixture.origin)
  database:close()
  local options = foundry.Options(fixture.url, fixture.origin, fixture.world,
    fixture.user, fixture.password, client, settings.public_url)
  local relay = server.Server(settings)
  defer relay:close()
  local startup: async.Task<|nil, value|>? = nil
  local failed = false
  local stopping = false
  defer if startup then hub.drain(startup) end
  local stop = function ()
    if stopping then return end
    stopping = true
    if startup then hub.drain(startup) end
    relay:close()
  end
  -- No browser exists before listen completes; arm graceful shutdown only
  -- after the Server owns its listener, before starting the browser Task.
  relay:start()
  local termination = async.run<|nil, value|>(function (): nil
    os.wait_signal("term")
    stop()
    return nil
  end)
  defer hub.drain(termination)
  local interrupt = async.run<|nil, value|>(function (): nil
    os.wait_signal("int")
    stop()
    return nil
  end)
  defer hub.drain(interrupt)
  startup = async.run<|nil, value|>(function (): nil
    os.stdout:write("Headless Foundry spike: starting\n")
    local session = foundry.start(options, args[2], args[3], relay.worlds)
    defer session:close()
    os.stdout:write("Headless Foundry spike: ready (authenticated relay and world-info)\n")
    while true do
      timer.sleep(1000)
      session:check(relay.worlds)
    end
    return nil
  catch
    -- CDP expressions, credentials, DOM and browser diagnostics stay private.
    if not stopping or error == "Browser cleanup failed" then
      failed = true
      local message = "startup or session failed"
      if error == "The paired world already has an active relay client" or
         error == "Foundry login form is unavailable" or
         error == "Foundry pairing settings do not match" or
         error == "Foundry loaded a different world" or
         error == "Foundry user is not the configured full GM" or
         error == "Foundry requires setup or an active REST API module" or
         error == "Foundry readiness timed out" or
         error == "Foundry readiness request failed" or
         error == "Headless browser exited" or
         error == "Headless Foundry session disconnected" or
         error == "Browser cleanup failed" then
        message = error
      end
      os.stderr:write("Headless Foundry spike: " .. message .. "\n")
    end
    relay:close()
    return nil
  end)
  relay:serve()
  stop()
  if failed then return 1 end
  os.stdout:write("Headless Foundry spike: stopped\n")
  return 0
catch
  os.stderr:write("Headless Foundry spike: check fixture, relay and browser configuration\n")
  return 1
end
