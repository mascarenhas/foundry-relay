# Run from an MSYS2 CLANG64 shell with a prepared native Windows Titan SDK.
# Use a local NTFS checkout distinct from the Unix source/object tree.
PREFIX ?= /c/Titan/sdk
# The Windows SDK ships the compiler as its own program and keeps the frontend
# script under share/lua/5.5/titan-compiler; the program resolves it itself.
TITAN_COMPILER := $(abspath $(PREFIX))/bin/titanc.exe
TITANC = "$(WINDOWS_PREFIX)/bin/titanc.exe"
TITAN_JOBS := 1
WINDOWS_ROOT := $(shell cygpath -m "$(abspath .)")
WINDOWS_PREFIX := $(shell cygpath -m "$(abspath $(PREFIX))")
OUTPUT_DIR := build/windows/out
WINDOWS_OUTPUT := $(shell cygpath -m "$(abspath $(OUTPUT_DIR))")
RUNTIME_DLLS := lua55.dll libuv-1.dll libllhttp-9.4.dll libsqlite3-0.dll libcrypto-3-x64.dll libssl-3-x64.dll
BUILD_FLAGS := --incremental --output "$(WINDOWS_OUTPUT)" -j $(TITAN_JOBS) \
	-DUSING_UV_SHARED=1 -I"$(WINDOWS_PREFIX)/include" -L"$(WINDOWS_PREFIX)/lib" \
	-lcrypto --ldflag=-Wl,--stack,8388608

export CC := clang
export AR := llvm-ar
export RANLIB := llvm-ranlib
export RC := llvm-rc
export MSYS2_ARG_CONV_EXCL := *
export TITAN_ROOT := $(WINDOWS_PREFIX)
export TITAN_RUNTIME_PREBUILT := 1
export TITAN_PROBE_CACHE_DISABLE := 1
export TITAN_PATH_0_6 := $(WINDOWS_PREFIX)/lib/titan/0.6

.DELETE_ON_ERROR:
.PHONY: all core-test-build test clean require-clang64
.DEFAULT_GOAL := all

require-clang64:
	test "$(MSYSTEM)" = CLANG64
	test -f "$(TITAN_COMPILER)" -a -f "$(PREFIX)/lib/titan/0.6/titan.dll"

# Both final images share compiler-owned objects, but keep relocatable payloads.
all: require-clang64
	+$(TITANC) $(BUILD_FLAGS) --exe "$(WINDOWS_OUTPUT)/bin/foundry-relay.exe" main
	mkdir -p build/windows/app/bin build/windows/app/lib/titan/0.6
	set -e; for name in $(RUNTIME_DLLS); do cp "$(PREFIX)/bin/$$name" build/windows/app/bin/; done
	cp "$(PREFIX)/lib/titan/0.6/titan.dll" build/windows/app/lib/titan/0.6/
	cp THIRD_PARTY_NOTICES.md build/windows/app/
	rm -rf build/windows/app/licenses
	mkdir -p build/windows/app/licenses
	cp "$(PREFIX)/share/titan/LICENSE" "$(PREFIX)/share/titan/THIRD_PARTY_NOTICES.md" build/windows/app/licenses/
	cp -R "$(PREFIX)/share/titan/LICENSES" build/windows/app/licenses/
	cp "$(OUTPUT_DIR)/bin/foundry-relay.exe" build/windows/app/bin/
	cp "$(OUTPUT_DIR)/lib/titan/0.6/main.dll" build/windows/app/lib/titan/0.6/

core-test-build: require-clang64
	+$(TITANC) $(BUILD_FLAGS) --test --tree . --test-dir tests --test-exclude tests.process_test --exe "$(WINDOWS_OUTPUT)/bin/relay-tests.exe" tests.router_test
	mkdir -p build/windows/test/bin build/windows/test/lib/titan/0.6
	set -e; for name in $(RUNTIME_DLLS); do cp "$(PREFIX)/bin/$$name" build/windows/test/bin/; done
	cp "$(PREFIX)/lib/titan/0.6/titan.dll" build/windows/test/lib/titan/0.6/
	cp "$(OUTPUT_DIR)/bin/relay-tests.exe" build/windows/test/bin/
	mkdir -p build/windows/test/lib/titan/0.6/tests
	cp "$(OUTPUT_DIR)/lib/titan/0.6/tests/router_test.dll" build/windows/test/lib/titan/0.6/tests/

test: all core-test-build
	powershell.exe -NoProfile -NonInteractive -File "$(WINDOWS_ROOT)/scripts/check-windows.ps1" -Application "$(WINDOWS_ROOT)/build/windows/app" -TestPayload "$(WINDOWS_ROOT)/build/windows/test" -ReadObj "$$(cygpath -m "$$(command -v llvm-readobj)")"

clean:
	rm -rf build/windows
