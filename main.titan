local os = import "os"
local async = import "async"
local config = import "relay.config"
local server = import "relay.server"
local hub = import "relay.hub"

function main(args: {string}): integer
  local settings = config.load()
  local relay = server.Server(settings)
  defer relay:close()
  local termination = async.run<|nil, value|>(function (): nil
    os.wait_signal("term")
    relay:close()
    return nil
  end)
  defer hub.drain(termination)
  local interrupt = async.run<|nil, value|>(function (): nil
    os.wait_signal("int")
    relay:close()
    return nil
  end)
  defer hub.drain(interrupt)
  relay:start()
  os.stdout:write("Foundry relay listening on " .. settings.host .. ":" .. settings.port .. "\n")
  relay:serve()
  return 0
catch
  os.stderr:write("Foundry relay failed: check configuration and database access\n")
  return 1
end
