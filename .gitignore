# Final executable/runner artifacts, configuration stamps, and coverage stages.
/build/
.titan-ls/

# Local credentials; example configuration files remain trackable.
.env
.env.*
.world
!.env.example
!.env.*.example

# Default credential database and SQLite sidecars. Keep fixtures trackable.
/relay.sqlite3
/relay.sqlite3-*

