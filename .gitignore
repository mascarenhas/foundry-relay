# Application, test, and Windows payloads use staged sources under build.
/build/
.titan-ls/

# Local credentials; example configuration files remain trackable.
.env
.env.*
.world
!.env.example
!.env.*.example

# Default credential database and SQLite sidecars. Keep fixtures trackable.
/relay.sqlite3
/relay.sqlite3-*

# Leftovers from source-tree compiler/test invocations.
/main
/tests/*_test
*.o
*.ffi.h
*.titan.h
